  },
  "قدری": {
    "bn": "নাইটিংগেল, পাপিয়া, মূল্যবান, গুরুত্বপূর্ণ, প্রধান",
    "ro": "Qdri"
  },
  "قدرے": {
    "bn": "বস্তুর পরিমেয় বৈশিষ্ট্য, পরিমাণ, সামান্য, অল্প, কম",
