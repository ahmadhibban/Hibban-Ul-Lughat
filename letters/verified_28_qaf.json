  },
  "قدرت": {
    "bn": "প্রকৃতি, মহাশক্তি, ক্ষমতা, প্রভাব",
    "ro": "Qudrat"
  },
  "قدرتی": {
    "bn": "প্রাকৃতিক, স্বাভাবিক, স্বভাবজাত, পদার্থবিদ্যা সংক্রান্ত",
    "ro": "Qudrati"
  },
  "قدردان": {
    "bn": "মূল্য রাখার পাত্র, মূল্যদানি, মূল্য এর আধার, মূল্য খোল",
    "ro": "Qdrdan"
  },
  "قدرداں": {
    "bn": "প্রশংসা, মর্যাদাদান, সমাদর, তারিফ, সমঝদারি",
