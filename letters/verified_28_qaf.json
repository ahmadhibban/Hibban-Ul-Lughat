  },
  "قبیلہ": {
    "bn": "গোত্র, সম্প্রদায়, উপজাতি, বংশ",
    "ro": "Qabilah"
  },
  "قتات": {
    "bn": "উদ্ধৃতি, সূত্র, রেফারেন্স, উল্লেখ",
    "ro": "Qattat"
  },
  "قتال": {
    "bn": "সংগ্রাম, সাফল্য, যুদ্ধ, লড়াই, লড়াকু মনোভাব",
    "ro": "Qtal"
  },
  "قتام": {
    "bn": "সমাপ্তি, অবসান, শেষ, চরম, পরিসমাপ্তি",
    "ro": "Qtam"
  },
  "قتل": {
    "bn": "হত্যা, নির্বাহ, সম্পাদন, প্রাণদণ্ড, নরহত্যা",
    "ro": "Qatl"
  },
  "قتلا": {
    "bn": "ত্রুটিযুক্ত বা নিম্নমানের বলে বাতিল জিনিস, অযোগ্য বিবেচিত হযে বাতিল ব্যক্তি, নাকচ করা, বাতিল করা, প্রত্যাখ্যান করা",
    "ro": "Qatla"
  },
  "قتلغہ": {
    "bn": "হত্যা, খুন, বধ, নরহত্যা, প্রাণনাশ",
    "ro": "Qatlghah"
  },
  "قتلما": {
    "bn": "হত্যা, খুন, বধ, নরহত্যা, প্রাণনাশ",
    "ro": "Qatalma"
  },
  "قتلہ": {
    "bn": "হত্যা, খুন, নরহত্যা, বধ",
    "ro": "Qtla"
  },
  "قتلی": {
    "bn": "হত্যা, খুন, বধ, নরহত্যা, প্রাণনাশ",
    "ro": "Qatli"
  },
  "قتلٰی": {
    "bn": "জনপ্রিয়তা, জনসাধারণ্যে প্রচলন, হত্যা, খুন, নরহত্যা",
    "ro": "Qtlaai"
  },
  "قتیل": {
    "bn": "খুনি, হত্যাকারী, ঘাতক, প্রাণহন্তা",
