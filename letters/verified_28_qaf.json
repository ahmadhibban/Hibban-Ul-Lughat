  },
  "قفس": {
    "bn": "মুরগির খাঁচা, আটকে ফেলা, আবদ্ধ করা, কাঠের তৈরি জাফরি, ধাতুর তৈরি জাফরি",
    "ro": "Qafas"
  },
  "قفل": {
    "bn": "চুলের গোছা, অলক, অলকগুচ্ছ, অলকদাম, চূর্ণকুন্তল",
    "ro": "Quful"
  },
  "قفلی": {
    "bn": "তালা প্রস্তুতকারক, তালাত্তয়ালা",
    "ro": "Qufli"
  },
  "قفلیاں": {
    "bn": "জুঁই ফুলের গাছ বিশেষ, জুঁই, তালা, কুলুপ, তালাচাবি",
    "ro": "Qflyan"
  },
  "ققنس": {
    "bn": "ফিনিক্স পাখি, কাল্পনিক অমর পাখি, ভস্ম থেকে পুনরুজ্জীবিত রূপকথার বিহঙ্গ",
    "ro": "Qaqnus"
  },
  "قلاب": {
    "bn": "কিছু ধরিয়া বা আটকাইয়া রাখার জন্য লৌহাদি নির্মিত আঙটা, আঙ্গুলসমূহ, কনুই বাঁকাইয়া মুষ্টিপ্রহার, হুক, কীলক",
    "ro": "Qullab"
  },
  "قلابازی": {
    "bn": "অ্যাক্রোব্যাটিক্স, দড়াবাজি, মল্লক্রীড়া, দড়াবাজি শিল্প, দক্ষ বিমানচালনা",
    "ro": "Qlabazi"
  },
  "قلابہ": {
    "bn": "কবজা, নিয়ন্ত্রণ, আয়ত্ত, বশ",
    "ro": "Qlaba"
  },
  "قلابی": {
    "bn": "গেঁড়া, ছেঁচড়ামি, জুয়াচুরি, তঁচকতা, কূটকর্ম",
    "ro": "Qlabi"
  },
  "قلابے": {
    "bn": "কব্জা, দখল, কর্তৃত্ব, দখলদারি",
    "ro": "Qlabe"
  },
  "قلادہ": {
    "bn": "ঘাড়, গ্রীবা, গলা, কণ্ঠদেশ",
    "ro": "Qlada"
  },
  "قلاوز": {
    "bn": "পরিশিষ্ট, পরিশিষ্টের, ক্রোড়পত্র, সংযোজনী",
    "ro": "Qlaoz"
  },
  "قلائد": {
    "bn": "নেকলেস, কণ্ঠহার, মালা, হার",
    "ro": "Qlaid"
  },
  "قلب": {
    "bn": "বরফ, জমাট বাঁধান, বিপর্যয়, শাঁস, শস্য",
    "ro": "Qalb"
  },
  "قلبانہ": {
    "bn": "হৃদয়, মন, অন্তঃকরণ, হৃৎপিণ্ড",
    "ro": "Qalbanah"
  },
  "قلبہ": {
    "bn": "হৃদয়, মন, অন্তর, হৃত্পিণ্ড, সাহস",
    "ro": "Qlba"
  },
  "قلت": {
    "bn": "অভাব, ক্ষুধা, অপ্রাচুর্য, দুর্ভিক্ষ, প্রবল আকাঙ্ক্ষা",
    "ro": "Qillt"
  },
  "قلتین": {
    "bn": "অভাব, প্রয়োজন, অনটন, শূন্যতা",
