  },
  "قرآن": {
    "bn": "পাঠক, প্রুফ্দ্রষ্টা, অধ্যেতা, বিশ্ববিদ্যালয়ের অধ্যাপক, পবিত্র আল কুরআন",
    "ro": "Qur'aan"
  },
  "قرابت": {
    "bn": "আত্মীয়তা, সম্পর্ক, যোগাযোগ, সম্বন্ধ",
    "ro": "Qarabat"
  },
  "قرابتی": {
    "bn": "একই বংশোদ্ভূত, রক্তের সম্পর্কযুক্ত, সমগোত্রীয়, সগোত্র, জ্ঞাতিসম্বন্ধযুক্ত",
    "ro": "Qrabti"
  },
  "قرابہ": {
    "bn": "সাধারণ মদের বোতলের প্রায় দ্বিগুণ আকারের গোলাকৃতি বোতল, বোতল, আত্মীয়তা, সম্পর্ক, যোগাযোগ",
    "ro": "Qraba"
  },
  "قرابین": {
    "bn": "অশ্বারোহী সৈন্যের দ্বারা ব্যবহৃত ছোটো বন্দুক, বন্দুক, বলিদান, আত্মত্যাগ, উৎসর্গ",
    "ro": "Qrabin"
  },
  "قرار": {
    "bn": "চুক্তি, মতৈক্য, ঐক্যমত, অনুমোদন, স্বীকৃতিদান",
    "ro": "Qaraar"
  },
  "قرارداد": {
    "bn": "সহকর্মী, সহযোগিতা করা, পণ, দৃঢ়, অটল সংকল্প",
    "ro": "Qrardad"
  },
  "قراری": {
    "bn": "স্থায়ী, স্থির, বাঁধা, অটল, ধরা",
    "ro": "Qarari"
  },
  "قران": {
    "bn": "একত্র, একই সময়ে, একই স্থানে, যুগপৎ, মিলিয়া মিশিয়া",
    "ro": "Qran"
  },
  "قراول": {
    "bn": "প্রহরী, পাহারাদার, চৌকিদার, দারোয়ান",
    "ro": "Qraol"
  },
  "قراءت": {
    "bn": "আবৃত্তি, বারবার বলা, পুনরাবৃত্তি, মুখস্থ করা",
    "ro": "Qrat"
  },
  "قرب": {
    "bn": "বিশ্বাস, আস্থা, আস্থাস্থাপন, ন্যাস, প্রত্যয়",
    "ro": "Qurb"
  },
  "قربان": {
    "bn": "উৎসর্গ, বলি, ত্যাগ",
    "ro": "Qurbaan"
  },
  "قربانی": {
    "bn": "বলিদান, ত্যাগ, বলি, বিসর্জন, পশুবলি",
    "ro": "Qurbaani"
  },
  "قربت": {
    "bn": "ঝোঁক, প্রবণতা, প্রীতি, অনুরাগ, আকর্ষণ",
    "ro": "Qurbat"
  },
  "قربوس": {
    "bn": "লাউ, কদু, সুস্বাদু পানীয় সবজি, মহানবী সা. এর প্রিয় খাদ্য",
    "ro": "Qrbos"
  },
  "قربٰی": {
    "bn": "প্রক্সিমিটি, নৈকট্য, থান, সান্নিধ্য, অধিকরণ",
    "ro": "Qrbaai"
  },
  "قرص": {
    "bn": "মিতা, ট্যাবলেট, চাকতি, ফলক, লেখার জন্য তক্তা",
    "ro": "Qurs"
  },
  "قرض": {
    "bn": "বিশ্বাস, আস্থা, কৃতিত্ব, সুনাম, সুখ্যাতি",
    "ro": "Qarz"
  },
  "قرضدار": {
    "bn": "সঙ্গীদের সম্পর্ক, দেনাদার, ঋণগ্রস্ত, ঋণে জর্জরিত ব্যক্তি",
    "ro": "Qrzdar"
  },
  "قرضہ": {
    "bn": "ঋণ, ধার, দেনা",
    "ro": "Qarza"
  },
  "قرط": {
    "bn": "শাস্তি বিলম্বিত করা, প্রাণদণ্ড বিলম্বিত করা, প্রাণদণ্ড স্থগিত রাখা, শাস্তি রদ করা, সাময়িক উপশম",
    "ro": "Qrt"
  },
  "قرطاس": {
    "bn": "কাগজপত্র, নথিপত্র, দলিল দস্তাবেজ, সরকারি পত্রাবলী",
    "ro": "Qirtas"
  },
  "قرطہ": {
    "bn": "আঁকা, টেনে আনা, আকৃষ্ট করা, লটারি খেলায় ভাগ্যপরীক্ষা",
    "ro": "Qrta"
  },
  "قرظ": {
    "bn": "ঋণ, ধার, দেনা",
    "ro": "Qaraz"
  },
  "قرع": {
    "bn": "গর্ব, অহংকার করা, গর্ব করা, জাঁক, বুকনি",
    "ro": "Qaraa"
  },
  "قرعہ": {
    "bn": "গোপন ভোটদানে ব্যবহৃত কাগজ, টিকিট ইত্যাদি, ভোটপত্র, ভোটদান, ভোটদান পর্ব",
    "ro": "Qaraah"
  },
  "قرعے": {
    "bn": "আঁকা, রঁজিত, চর্চা করা, টেনে আনা",
    "ro": "Qrae"
  },
  "قرفہ": {
    "bn": "দারুচিনি, সুগন্ধি মসলাবিশেষ, দারচিনি, ডালচিনি",
    "ro": "Qirfah"
  },
  "قرقرانا": {
    "bn": "গ্রান্টিং, ঘোঁৎ ঘোঁৎ করা",
    "ro": "Qarqarana"
  },
  "قرم": {
    "bn": "কুরআন, পবিত্র আল কুরআন, মহাগ্রন্থ, ঐশী বাণী",
    "ro": "Qurrm"
  },
  "قرمچ": {
    "bn": "নাকাল, ক্লেশিত, নিগ্রহ",
    "ro": "Qirmica"
  },
  "قرمز": {
    "bn": "ঘন লাল রং, অলক্তবর্ণ, গাঢ় লাল রঙে রঞ্জিত করা, আরক্ত, ক্রিমসন",
    "ro": "Qirmiz"
  },
  "قرمزی": {
    "bn": "সমস্ত, সকল, সম্পূর্ণ, সব, সম্পূর্ণভাবে",
    "ro": "Qirmizi"
  },
  "قرنفل": {
    "bn": "সর্বদা, আকছার, হরবখত, সবসময়, চিরকাল",
    "ro": "Qaranful"
  },
  "قرنیا": {
    "bn": "চোখের তারার স্বচ্ছ আবরণ, অচ্ছেদাপটল, অচ্ছোদপটল",
    "ro": "Qarnya"
  },
  "قرون": {
    "bn": "সেঞ্চুরি, শতক, একশ",
    "ro": "Qron"
  },
  "قرء": {
    "bn": "আবৃত্তি, বারবার বলা, পুনরাবৃত্তি, মুখস্থ করা",
    "ro": "Qur"
  },
  "قریات": {
    "bn": "গ্রাম, গাঁ, পল্লী, পল্লীগ্রাম, দেহাত",
    "ro": "Qryat"
  },
  "قریب": {
    "bn": "বিষয়ে, নিকট, প্রায়, ব্যাপৃত, ঘুরিয়া",
    "ro": "Qarib"
  },
  "قریباً": {
    "bn": "প্রায়, কাছাকাছি, আনুমানিক, কমবেশি",
    "ro": "Qribaan"
  },
  "قریبہ": {
    "bn": "প্রায়, কাছাকাছি, আনুমানিক, কমবেশি",
    "ro": "Qaribah"
  },
  "قریبی": {
    "bn": "বন্ধ, রুদ্ধ, তালাবদ্ধ, বাঁধ",
    "ro": "Qaribi"
  },
  "قریحت": {
    "bn": "গন্ধ, দুর্গন্ধ, ঘ্রাণ, সুবাস",
    "ro": "Qarihat"
  },
  "قریض": {
    "bn": "ঋণ, ধার, দেনা",
    "ro": "Qariz"
  },
  "قرین": {
    "bn": "একই বংশোদ্ভূত, রক্তের সম্পর্কযুক্ত, সমগোত্রীয়, সগোত্র, জ্ঞাতিসম্বন্ধযুক্ত",
    "ro": "Qarin"
  },
  "قریناں": {
    "bn": "পবিত্র আল কুরআন, মহাগ্রন্থ, ঐশী বাণী",
    "ro": "Qrinan"
  },
  "قرینہ": {
    "bn": "নিয়ম, শৃঙ্খলা, অনুমান, সূত্র, লক্ষণ",
    "ro": "Qarinah"
  },
  "قریہ": {
    "bn": "গ্রাম, পল্লি, গাঁও, গ্রামাঞ্চল",
    "ro": "Qaryah"
  },
  "قریے": {
    "bn": "রিডিং, রিডিংস",
    "ro": "Qrye"
  },
  "قریٰ": {
    "bn": "নগর, গ্রাম, গাঁ, পল্লী, পল্লীগ্রাম",
    "ro": "Qryaa"
  },
  "قرأت": {
    "bn": "শৈত্য, ঠাণ্ডা ভাব, ঠাণ্ডাই, উত্সাহশূন্য ভাব, উদাসীনতা",
    "ro": "Qirt"
  },
  "قزاحیت": {
    "bn": "বিবাহ, বিয়ে, নিকাহ, শাদি, পরিণয়",
    "ro": "Quzahyat"
  },
  "قزاق": {
    "bn": "হাইওয়ে, ডাকাত, লুঠেরা, অপহারক, অপহর্তা",
    "ro": "Qazzaq"
  },
  "قزح": {
    "bn": "রংধনু, রামধনু, বর্ণচ্ছত্র, আকাশে সপ্তবর্ণের ধনুক",
    "ro": "Quzah"
  },
  "قزحیہ": {
    "bn": "আইরিস, কনীনিকা, চোখের তারা বা মণি, রামধনু",
    "ro": "Qazhyah"
  },
  "قزع": {
    "bn": "অনুমান, ধারণা, সংশয়, আন্দাজ",
    "ro": "Qazaa"
  },
  "قس": {
    "bn": "উদাঃ, পূর্বের, অপ, খারাপ",
    "ro": "Qis"
  },
  "قسامت": {
    "bn": "সৌন্দর্য, কমনীয়তা, চরম উৎকর্ষ, চরম গুণ, শ্রেষ্ঠত্ব",
    "ro": "Qsamt"
  },
  "قسائی": {
    "bn": "কসাইখানা, জবাইখানা, পশু জবাইয়ের স্থান, মাংসালয়",
    "ro": "Qsai"
  },
  "قسط": {
    "bn": "খেপ, ন্যায়বিচার, বিচারপতি, সুবিচার, ন্যায়",
    "ro": "Qist"
  },
  "قسم": {
    "bn": "শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ, পরীক্ষার ফলভিত্তিক বিভাগ",
    "ro": "Qism"
  },
  "قسمت": {
    "bn": "ভাগ, বিভাগ, সীমান্তরেখা, মতানৈক্য, অংশভাগ করা",
    "ro": "Qismat"
  },
  "قسمیں": {
    "bn": "প্রকার, ধরন, রূপ, রকম",
    "ro": "Qism"
  },
  "قسمیہ": {
    "bn": "দয়া, অনুগ্রহ, কৃপা, করুণা",
    "ro": "Qsmih"
  },
  "قسور": {
    "bn": "ত্রুটি, অপূর্ণতা, ত্রুটিবিচু্যতি, অভাব",
    "ro": "Qsor"
  },
  "قسوط": {
    "bn": "পর্ব, পার্শ্ব, পূর্ণাঙ্গ বাক্য",
    "ro": "Qsot"
  },
  "قسوہ": {
    "bn": "কুসংস্কার, পূর্বাহ্নে কৃত অনুকূল বা প্রতিকূল ধারণা, পক্ষপাত, ক্ষতি অনিষ্ট বা আঘাত, পক্ষপাতগ্রস্থ করা",
    "ro": "Qsoh"
  },
  "قسیس": {
    "bn": "খ্রিষ্টান ধর্মযাজক, পুরোহিত, পাদ্রি",
    "ro": "Qsis"
  },
  "قشفہ": {
    "bn": "প্রকাশ, প্রকাশনা, প্রচার, বিজ্ঞাপন",
    "ro": "Qshfa"
  },
  "قصاب": {
    "bn": "গোশত বিক্রেতা, মাংস ব্যবসায়ী, জীব জবাইকারী, গোশত প্রস্তুতকারী",
    "ro": "Qassaab"
  },
  "قصابی": {
    "bn": "গোশত বিক্রেতা, মাংস ব্যবসায়ী, জীব জবাইকারী",
    "ro": "Qassabi"
  },
  "قصاص": {
    "bn": "প্রতিশোধ, কোনো কাজের জন্য প্রাপ্য পুরস্কার ইঃ পাওনা, প্রতিফল, বদলা",
    "ro": "Qisaas"
  },
  "قصائد": {
    "bn": "সাহস, সাহসিকতা, বীরত্ব, অকুতোভয়তা, অভয়",
    "ro": "Qsaid"
  },
  "قصائی": {
    "bn": "কসাইখানা, জবাইখানা, পশু জবাইয়ের স্থান, মাংসালয়",
    "ro": "Qasaai"
  },
  "قصبات": {
    "bn": "মফস্বল, শহর, নগর, পুর, নিগম",
    "ro": "Qasbaat"
  },
  "قصباتی": {
    "bn": "শহুরে, নাগরিক, নগরবাসী, শহরবাসী, নগরীয়",
    "ro": "Qsbati"
  },
  "قصبہ": {
    "bn": "শহর, নগর, পুর, নিগম, পট্টন",
    "ro": "Qasba"
  },
  "قصد": {
    "bn": "শরসন্ধান করা, লক্ষ্যের দিকে বন্দুক প্রভৃতি নিশানা করা, তাগ করা, টিপ করা, কাউকে লক্ষ্য করে বা কারো উদ্দেশে কিছু বলা বা ব্যবস্থা গ্রহণ করা",
    "ro": "Qasd"
  },
  "قصداً": {
    "bn": "জ্ঞাতসারে, ইচ্ছাপূর্বক, ভেবেচিন্তে, উদ্দেশ্যমূলকভাবে, উদ্দেশ্যে",
    "ro": "Qsdaan"
  },
  "قصدًا": {
    "bn": "কামলোলুপতা, কামলালসা, উদ্দেশ্যমূলকভাবে, উদ্দেশ্যে, জন্য",
    "ro": "Qsdana"
  },
  "قصر": {
    "bn": "দুর্গ, ভরসাস্থল, সংক্ষিপ্তকরণ, সংকোচনকরণ, কমা",
    "ro": "Qasr"
  },
  "قصص": {
    "bn": "কাহিনিসমূহ, কিচ্ছা, উপাখ্যানমালা, নবীদের জীবনী আখ্যান কাসাসুল আম্বিয়া, ঐতিহাসিক গল্পমালা",
    "ro": "Qss"
  },
  "قصور": {
    "bn": "সাবধানতা, পূর্বাহ্নে জ্ঞাপন করা, সাবধান থাকা, সতর্ক করিয়া দেওয়া, আদেশ জানাইয়া দেওয়া",
    "ro": "Qasur"
  },
  "قصہ": {
    "bn": "অবাস্তব, প্রধানত অলৌকিক বা অতিলৌকিক গল্প, আখ্যায়িকা, উপকথা, পৌরাণিক গল্প",
    "ro": "Qissa"
  },
  "قصیر": {
    "bn": "সংক্ষিপ্ত, সংক্ষেপিত, সারসংক্ষেপ, মোটাদাগে",
    "ro": "Qasir"
  },
  "قضا": {
    "bn": "দৃষ্টিগ্রাহ্য বা বোধগম্য কারণ ছারা যা ঘটে, সুযোগ, মৃতু্য, মরণ, জীবননাশ",
    "ro": "Qazaa"
  },
  "قضاب": {
    "bn": "হুজুগ, উত্তেজনা, মাতন, উত্তেজন, উষ্মা",
    "ro": "Qzab"
  },
  "قضات": {
    "bn": "বিচারকবৃন্দ, কাজীগণ, ন্যায়বিচারকমণ্ডলী, বিচারকসমাজ",
    "ro": "Quzaat"
  },
  "قضاعہ": {
    "bn": "মুর্খ, জ্ঞানহীন, অবিদিত, সম্পত্তি, বৈশিষ্ট",
    "ro": "Qzaah"
  },
  "قضاکار": {
    "bn": "বিচারকগণ, বিচারক, বিচারপতি, মুনসেফ",
    "ro": "Qzakar"
  },
  "قضایا": {
    "bn": "রায়, হুকুম, আদেশ, নির্দেশ",
    "ro": "Qzaya"
  },
  "قضبان": {
    "bn": "বার, দফা, সময়, সুযোগ",
    "ro": "Qzban"
  },
  "قضیب": {
    "bn": "তরবারি, অসি, তলোয়ার, তরোয়াল, পুংজননেন্দ্রিয়",
    "ro": "Qazib"
  },
  "قضیہ": {
    "bn": "পরিবর্তন, বদল, বিনিময়, বৈচিত্র্য, অপবর্তন",
    "ro": "Qzih"
  },
  "قطاب": {
    "bn": "ডাক, চিঠি, পদ",
    "ro": "Qtab"
  },
  "قطار": {
    "bn": "সারি, চুলের বিনুনি, বেণী, সারেমধ্যে স্থাপন করা, সারেমধ্যে স্থান লত্তয়া",
    "ro": "Qitaar"
  },
  "قطاع": {
    "bn": "সেক্টর, বিভাগ, বৃত্তকলা, বৃত্তকলাকার বস্তু, শাখা",
    "ro": "Qitaa"
  },
  "قطب": {
    "bn": "মেরু, মেরুবিন্দু, ধ্রুবতারা, সাধকশ্রেষ্ঠ, কেন্দ্রবিন্দু",
    "ro": "Qutb"
  },
  "قطبی": {
    "bn": "জ্যোতির্বিজ্ঞানী, জ্যোতির্বিদ, প্রভুত্বের আইনসম্মত অধিকার, কর্তৃত্ব, অধিকার",
    "ro": "Qutbi"
  },
  "قطبین": {
    "bn": "খুঁটি, ডাক, চিঠি, পদ",
    "ro": "Qtbin"
  },
  "قطبئ": {
    "bn": "মেরূর নিকটবর্তী, অক্ষবর্তী, মেরূপ্রবণতাযুক্ত, চৌম্বকশক্তিসম্পন্ন, সম্পূর্ণ বিরোধী",
    "ro": "Qtbi"
  },
  "قطر": {
    "bn": "ব্যাস, জ্যা, সেতার, বীণা প্রভৃতি বাদ্যযন্ত্রের তার, কর্ণ",
    "ro": "Qatar"
  },
  "قطرات": {
    "bn": "ফোঁটাসমূহ, জলবিন্দুগুলো, বৃষ্টির ফোঁটাগুলো, অশ্রুবিন্দুমালা",
    "ro": "Qatraat"
  },
  "قطران": {
    "bn": "টার, আলকাতরা, পিচ, আলকাতরা মাখান, পিচ দেওয়া",
    "ro": "Qtran"
  },
  "قطروں": {
    "bn": "ফোঁটা, বিন্দু, কেন্দ্রবিন্দু, দৃষ্টিভঙ্গি",
    "ro": "Qatr"
  },
  "قطرہ": {
    "bn": "ফোঁটা, বিন্দু, জলবিন্দু, পানির ফোঁটা, অশ্রুবিন্দু",
    "ro": "Qatra"
  },
  "قطع": {
    "bn": "সমাপ্তি, অবসান, ইতি, শেষ, পূর্ণতা",
    "ro": "Qata"
  },
  "قطعاً": {
    "bn": "একেবারে, পুরোপুরি, সম্পূর্ণরূপে, আপাদমস্তক",
    "ro": "Qtaan"
  },
  "قطعن": {
    "bn": "তুলো, কার্পাস, সূতিবস্ত্র, অনুরক্ত হওয়া, অবশ্যই",
    "ro": "Qtan"
  },
  "قطعنی": {
    "bn": "সংজ্ঞায়িত, নিশ্চিত, নির্ধারক, সীমানির্দেশক, চূড়ান্ত",
    "ro": "Qtani"
  },
  "قطعہ": {
    "bn": "অভিজ্ঞান, স্মরণচিহ্ন, স্মৃতিচিহ্ন, অনুস্মারক, ভূখণ্ড",
    "ro": "Qitah"
  },
  "قطعی": {
    "bn": "চূড়ান্ত, সুনির্দিষ্ট, চূড়ান্তভাবে, অবশ্যম্ভাবী",
    "ro": "Qati"
  },
  "قطعیت": {
    "bn": "নিশ্চিততা, নিশ্চয়তা",
    "ro": "Qatiit"
  },
  "قطعًا": {
    "bn": "পরেও, নিশ্চিতভাবেই, অবশ্যই, স্বভাবত, হ্যাঁ",
    "ro": "Qtaana"
  },
  "قطنی": {
    "bn": "কোমর, কটিদেশ, মাজা, কটিবন্ধ",
    "ro": "Qtni"
  },
  "قطوط": {
    "bn": "বিভাগ, অংশ, শাখা, দপ্তর",
    "ro": "Qtot"
  },
  "قطیع": {
    "bn": "বিচ্ছেদ, বিরহ, বিচ্ছিন্নতা, দূরত্ব",
    "ro": "Qtya"
  },
  "قعدہ": {
    "bn": "অবস্থান, স্থান, জায়গা, সাইট",
    "ro": "Qaadah"
  },
  "قعقہ": {
    "bn": "কাকা, মামা, জেঠা, পিসা",
    "ro": "Qaqa"
  },
  "قعود": {
    "bn": "আন্তরিকতা, সহৃদয়তা, প্রগাঢ় স্নেহ, সরলতা, আদর",
    "ro": "Qaod"
  },
  "قعید": {
    "bn": "কায়েদ, নেতা, পথপ্রদর্শক, সর্দার",
