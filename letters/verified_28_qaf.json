{
  "قاب": {
    "bn": "স্থান, জায়গা, ব্যবধান, অবকাশ, আয়তা",
    "ro": "Qaab"
  },
  "قابض": {
    "bn": "দখলদার, দখলকারী, কোষ্ঠকাঠিন্য সৃষ্টিকারী, নিয়ন্ত্রণকারী, অধিগ্রহণকারী",
    "ro": "Qaabiz"
  },
  "قابل": {
    "bn": "যোগ্য, উপযুক্ত, দক্ষ, काबिल",
    "ro": "Qaabil"
  },
  "قابلہ": {
    "bn": "মিডওয়াইফারি, ধাত্রীবিদ্যা, প্রসুতিতন্ত্র, ধাত্রীর কাজ",
    "ro": "Qablah"
  },
  "قابلیت": {
    "bn": "যোগ্যতা, সামর্থ্য, দক্ষতা, মেধা, পারদর্শিতা",
    "ro": "Qaabliyat"
  },
  "قابو": {
    "bn": "সুবিধা, সময়, সুযোগ, অবসর, বেলা",
    "ro": "Qaabu"
  },
  "قاتل": {
    "bn": "খুনী, গোপন হত্যাকারী, গুপ্তঘাতক, প্রাণান্তকর, মারাত্মক",
    "ro": "Qaatil"
  },
  "قاتلہ": {
    "bn": "হত্যা, খুন, বধ, নরহত্যা, প্রাণনাশ",
    "ro": "Qatilah"
  },
  "قاچاقی": {
    "bn": "চোরাচালানকারী, পাচারকারী, চোরাকারবারি, অবৈধ পণ্য বহনকারী",
    "ro": "Qaachaaqi"
  },
  "قادح": {
    "bn": "কাপ, পেয়ালা, চায়ের পেয়ালা, বিজয়ের ট্রফি কাপ",
    "ro": "Qadih"
  },
  "قادر": {
    "bn": "সক্ষম, যোগ্য, ক্ষমতাসম্পন্ন, বিচক্ষণ",
    "ro": "Qadir"
  },
  "قادم": {
    "bn": "আসছে, পরবর্তী, আয়েন্দা",
    "ro": "Qadim"
  },
  "قادوس": {
    "bn": "বাক্স, সিন্দুক, পেটিকা, কোষ",
    "ro": "Qados"
  },
  "قار": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "Qar"
  },
  "قارب": {
    "bn": "আত্মীয়স্বজন, বন্ধুবর্গ, সুহৃদগণ, প্রিয়জনবৃন্দ",
    "ro": "قارب"
  },
  "قارت": {
    "bn": "আবৃত্তি, বারবার বলা, পুনরাবৃত্তি, মুখস্থ করা",
    "ro": "Qart"
  },
  "قارع": {
    "bn": "পাঠক, প্রুফ্দ্রষ্টা, অধ্যেতা, বিশ্ববিদ্যালয়ের অধ্যাপক",
    "ro": "Qara"
  },
  "قارعہ": {
    "bn": "আবৃত্তি, বারবার বলা, পুনরাবৃত্তি, মুখস্থ করা",
    "ro": "Qaryah"
  },
  "قارورہ": {
    "bn": "প্রস্রাবের পাত্র, কাচের বোতল, ডাক্তারি নমুনা শিশি",
    "ro": "Qarorah"
  },
  "قارونیت": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "Qaroniit"
  },
  "قارہ": {
    "bn": "মহাদেশ, বিশাল ভূখণ্ড, পৃথিবীর প্রধান সাতটি ভৌগোলিক খণ্ড, মহাদেশীয় ভূভাগ",
    "ro": "Qarra"
  },
  "قاری": {
    "bn": "ক্বারী, কুরআন তেলাওয়াতকারী, সহীহ শুদ্ধ কুরআন পাঠক, তাজবিদ বিশারদ, আবৃত্তিকার",
    "ro": "Qaari"
  },
  "قارئین": {
    "bn": "পাঠক, শিক্ষক, অধ্যাপক, ধর্মশাস্ত্রের শিক্ষক",
    "ro": "Qariin"
  },
  "قاز": {
    "bn": "হংসী, রাজহংসী, বোকা লোক, কর্ম, পেশা",
    "ro": "Qaz"
  },
  "قازہ": {
    "bn": "তাকদির, বিধিলিপি, মৃত্যু",
    "ro": "Qazah"
  },
  "قاسر": {
    "bn": "অক্ষম, অযোগ্য, অপদার্থ, অনুপযুক্ত",
    "ro": "Qasir"
  },
  "قاسرہ": {
    "bn": "সংক্ষিপ্ত, সংক্ষেপিত, সারসংক্ষেপ, মোটাদাগে",
    "ro": "قاسرہ"
  },
  "قاش": {
    "bn": "টুকরা, অংশ, খণ্ড, উদাহরণ, ভাগ",
    "ro": "Qasa"
  },
  "قاشیں": {
    "bn": "খড়, ঘাস, পশুখাদ্য, ভুসি",
    "ro": "Qashin"
  },
  "قاصد": {
    "bn": "মেসেঞ্জার, বার্তাবহ, বার্তাবাহক, দূত",
    "ro": "Qasid"
  },
  "قاصدہ": {
    "bn": "মেসেঞ্জার, বার্তাবহ, বার্তাবাহক, দূত",
    "ro": "قاصدہ"
  },
  "قاصر": {
    "bn": "অক্ষম, অযোগ্য, অপদার্থ, অনুপযুক্ত",
    "ro": "Qasir"
  },
  "قاض": {
    "bn": "বিচারক, বিচারপতি, মুনসেফ, হাকিম",
    "ro": "Qaz"
  },
  "قاضی": {
    "bn": "ইসলামি বিচারক, শরীয়তের আদালতপ্রধান, বিচারপতি, নিকা বা বিবাহ রেজিস্ট্রার",
    "ro": "Qaazi"
  },
  "قاطبہ": {
    "bn": "ঠিকানা, গন্তব্য, সন্ধান, হদিস",
    "ro": "Qatibah"
  },
  "قاطر": {
    "bn": "খচ্চর, অশ্ব ও গর্দভের সংকর প্রাণী, ভারবাহী জন্তুবিশেষ, শক্তিশালী মালবাহী পশু",
    "ro": "Qatir"
  },
  "قاطع": {
    "bn": "কাটার কাজ, কর্তন, ছেদন, ছায়াছবি ইত্যাদির আপত্তিকর অংশের ছাঁটাই, নির্ণায়ক",
    "ro": "Qatya"
  },
  "قاطعۃً": {
    "bn": "অবশ্যই, স্পষ্টভাবে, হ্যাঁ, নিশ্চয়ই",
    "ro": "Qata"
  },
  "قاطن": {
    "bn": "তুলা, কার্পাস, তুলো, সুতো তৈরির আঁশ",
    "ro": "Qatin"
  },
  "قاعد": {
    "bn": "নিয়ম, কানুন, সংবিধান, আইন",
    "ro": "Qaid"
  },
  "قاعدہ": {
    "bn": "ভিত্তি, মূল নীতি, কোনো মিশ্রণের প্রধান উপাদান, নিয়ম, কানুন",
    "ro": "Qaaida"
  },
  "قاعدی": {
    "bn": "নিয়ম, কানুন, সংবিধান, আইন",
    "ro": "Qaidi"
  },
  "قافلوں": {
    "bn": "কনভয়, রক্ষণাবেক্ষণার্থ সঙ্গী হওয়া",
    "ro": "Qaafil"
  },
  "قافلہ": {
    "bn": "কনভয়, জাহাজ প্রভৃতি পাহার দিয়ে নিয়ে যাওয়া, পাহারা দেবার জন্য অনুগমন, বহর",
    "ro": "Qaafila"
  },
  "قافلے": {
    "bn": "কাফেলাসমূহ, যাত্রীদলগুলো, পদযাত্রাগুলো, ব্যবসায়ী কাফেলা",
    "ro": "Qaafile"
  },
  "قافی": {
    "bn": "যথেষ্ট, পর্যাপ্ত, বাস যানবাহন, ব্যস",
    "ro": "Qafi"
  },
  "قافیہ": {
    "bn": "কবিতার অস্ত্যমিল, মিত্রাক্ষর কবিতা, অনুরূপ ধ্বনি সাদৃশ্য, মিলবিশিষ্ট হওয়া, সন্ধ্বনিযুক্ত হওয়া",
    "ro": "Qaafiya"
  },
  "قاق": {
    "bn": "দাঁড়কাক, পাতিকাক, পরিবেশের ময়লা পরিষ্কারক চতুর পাখি",
    "ro": "Qaq"
  },
  "قاقم": {
    "bn": "এরল বা এরমাইন, উত্তর মেরুর মূল্যবান সাদা পশমধারী ক্ষুদ্র প্রাণী",
    "ro": "Qaaqum"
  },
  "قالب": {
    "bn": "ছাঁচ, কাঠামো, ডাইস, ছাঁচে ফেলার ছাঁচ",
    "ro": "Qalib"
  },
  "قالبی": {
    "bn": "ছাঁচ, কাঠামো, ডাইস, ছাঁচে ফেলার ছাঁচ",
    "ro": "Qalibi"
  },
  "قالع": {
    "bn": "দুর্গ, গড়, সুরক্ষিত সেনাছাউনি",
    "ro": "Qalya"
  },
  "قالی": {
    "bn": "কার্পেট, গালিচা, ফারসি কার্পেট, মেঝের সুদৃশ্য নরম আস্তরণ",
    "ro": "Qali"
  },
  "قالیچہ": {
    "bn": "ছোট কার্পেট, গালিচা, পাটি, নরম বসার আসন, ফারসি মেঝের জাজিম",
    "ro": "Qalichah"
  },
  "قالین": {
    "bn": "গালিচা, কার্পেট, ফারসি কার্পেট, মেঝের সুদৃশ্য নরম আস্তরণ, পশমি জাজিম",
    "ro": "Qaalin"
  },
  "قامت": {
    "bn": "দেহ, মূল কাঠামো, সংঘবদ্ধ ব্যক্তিবৃন্দ, শরীর, গঠন",
    "ro": "Qamat"
  },
  "قاموس": {
    "bn": "মহাসাগর, সমুদ্র, সাগর, মহাসমুদ্র, সিন্ধু",
    "ro": "Qaamus"
  },
  "قانع": {
    "bn": "প্রত্যয়, বিশ্বাস, আস্থা, ভরসা",
    "ro": "Qanya"
  },
  "قانون": {
    "bn": "পিয়ানোর আদিরূপ, কর্ম, ক্রিয়া, কাজ, কর্মানুষ্ঠান",
    "ro": "Qaanun"
  },
  "قانونی": {
    "bn": "আইনি, বিধিসম্মত, বৈধ, আইনগত",
    "ro": "Qaanuni"
  },
  "قاں": {
    "bn": "সর্দার, অধিপতি, নেতা",
    "ro": "Qan"
  },
  "قاویہ": {
    "bn": "কবিতা, পদ্য, কাব্য, শের",
    "ro": "Qaoyah"
  },
  "قاہر": {
    "bn": "কায়রো, মিশরের ঐতিহাসিক রাজধানী, আল আজহারের পুণ্যময় নগরী, নীল নদের তীরের মহানগরী",
    "ro": "Qahir"
  },
  "قاہرہ": {
    "bn": "কায়রো, মিশরের ঐতিহাসিক রাজধানী, আল আজহারের পুণ্যময় নগরী, নীল নদের তীরের মহানগরী",
    "ro": "Qaahira"
  },
  "قائحات": {
    "bn": "প্রবিধান, কানুন, নিয়মাবলী, বিধিমালা",
    "ro": "Qaihat"
  },
  "قائد": {
    "bn": "অধিনায়ক, দলপতি, সেনাপতি, নেতা, সর্দার",
    "ro": "Qaaid"
  },
  "قائدانہ": {
    "bn": "নেতৃত্বসুলভ, নায়কোচিত, পথপ্রদর্শনকারী, দলনেতার মতো",
    "ro": "Qaaidaana"
  },
  "قائدہ": {
    "bn": "কায়দা, শৈলী, ধরন, অবস্থা",
    "ro": "Qaidah"
  },
  "قائدین": {
    "bn": "নেতৃবৃন্দ, চালকবৃন্দ, পথপ্রদর্শকগণ",
    "ro": "Qaaidin"
  },
  "قائل": {
    "bn": "স্বীকারকারী, অনুসারী, বিশ্বাসী, সম্মত, মেনে নেওয়া ব্যক্তি",
    "ro": "Qaail"
  },
  "قائلہ": {
    "bn": "প্ররোচনা, কিস্তি দাবা খেলায়, বাদশাহকে আক্রমণ, উসকানি",
    "ro": "قائلہ"
  },
  "قائلین": {
    "bn": "স্বীকারকারীমণ্ডলী, স্বীকারকারীগণ, স্বীকারকারীবৃন্দ, সকল স্বীকারকারী",
    "ro": "Qailin"
  },
  "قائم": {
    "bn": "প্রতিষ্ঠিত, কায়েম, অবিচল, অটল",
    "ro": "Qaaim"
  },
  "قائماً": {
    "bn": "দাঁড়ানো, স্থায়ী, খাড়া, ঠাড়, ঢালাও",
    "ro": "Qaimaan"
  },
  "قائمہ": {
    "bn": "দাঁড়ানো, ওঠা, জাগ্রত হওয়া, উদিত হওয়া",
    "ro": "Qaimah"
  },
  "قائمی": {
    "bn": "স্থায়িত্ব, অস্তিত্ব, দৃঢ়তা, দ্রঢ়িমা, শক্তি",
    "ro": "Qaimi"
  },
  "قباب": {
    "bn": "গম্বুজ, চূড়া, মসজিদের সুউচ্চ গম্বুজ, মিনারের ওপরের গোলাকার ছাদ",
    "ro": "Qabab"
  },
  "قباحت": {
    "bn": "ত্রুটি, কোনো নীতি বা দল ত্যাগ করা, দোষ, অসম্পূর্ণতা, অভাব",
    "ro": "Qabaahat"
  },
  "قبائح": {
    "bn": "গ্রাম, পল্লি, গাঁও, গ্রামাঞ্চল",
    "ro": "Qabaih"
  },
  "قبائل": {
    "bn": "উপজাতি, গোত্র, সম্প্রদায়, বংশ",
    "ro": "Qabail"
  },
  "قبائلی": {
    "bn": "উপজাতি, গোত্র, সম্প্রদায়, বংশ",
    "ro": "Qabaili"
  },
  "قبح": {
    "bn": "কুৎসিত, খারাপ, মন্দ, অশুভ",
    "ro": "Quba"
  },
  "قبر": {
    "bn": "সমাধি, গোর, কারবালা, গোরস্থানযুক্ত বৃহত কক্ষ, কবরোপরি স্মৃতিস্তম্ভ",
    "ro": "Qabr"
  },
  "قبرستان": {
    "bn": "সমাধিক্ষেত্র, গোরস্থান, কবর, গোর",
    "ro": "Qabristaan"
  },
  "قبرکن": {
    "bn": "সমাধি পাথর, সমাধিপ্রস্তর",
    "ro": "Qbrkn"
  },
  "قبض": {
    "bn": "পাকড়াত্ত, পাকড়, গ্রাহ, দখল, ক্রোক",
    "ro": "Qabz"
  },
  "قبضت": {
    "bn": "কোষ্ঠকাঠিন্য, কোষ্ঠবদ্ধতা, দখল",
