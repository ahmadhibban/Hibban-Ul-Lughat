  },
  "قلع": {
    "bn": "টিন ধাতু, উপড়ে ফেলা, দুর্গ, সুরক্ষিত কেল্লা, উৎপাটিত করা",
    "ro": "Qal'"
  },
  "قلعہ": {
    "bn": "দীর্ঘ, লম্বা, সুদীর্ঘ, দীর্ঘকালব্যাপী, প্রাংশু",
    "ro": "Qil'a"
  },
  "قلعی": {
    "bn": "দুর্গ, গড়, সুরক্ষিত সেনাছাউনি",
    "ro": "Qlai"
  },
  "قلعے": {
    "bn": "কেল্লাগুলো, দুর্গগুলো, সুরক্ষাপ্রাচীরসমূহ",
    "ro": "Qil'e"
  },
  "قلق": {
    "bn": "উদ্বেগ, চিন্তা, ভাবনা, উৎকণ্ঠা",
    "ro": "Qalaq"
  },
  "قلم": {
    "bn": "লেখনী, লেখার কাঠি, নলখাগড়ার কাঠি, লেখালেখির সামগ্রী",
    "ro": "Qalam"
  },
  "قلماش": {
    "bn": "রাজ হংসী, লেখনী, লিখনী",
    "ro": "Qlmasa"
  },
  "قلماق": {
    "bn": "কলোনি, উপনিবেশ, নতুন বসতি, বিজিত ভূখণ্ড",
    "ro": "Qlmaq"
  },
  "قلمبند": {
    "bn": "শাস্তি, দণ্ড, সাজা, যন্ত্রণা",
    "ro": "Qlmbnd"
  },
  "قلمدان": {
    "bn": "বাটা, মিশ্রণ, ছিনালি, পোর্টফোলিও, আলগা কাগজপত্র রাখার জন্য ব্যাগ বা খাতা",
    "ro": "Qlmdan"
  },
  "قلمرو": {
    "bn": "রাজ্য, সাম্রাজ্য, শাসনাধীন এলাকা, কর্তৃত্বাধীন সীমানা, রাজত্ব",
    "ro": "Qlmro"
  },
  "قلمزن": {
    "bn": "কলম, লেখনী, লিখনী, বলপেন",
    "ro": "Qlmzn"
  },
  "قلمکار": {
    "bn": "লেখক, গ্রন্থকার, রচয়িতা, সাহিত্যিক",
    "ro": "Qlmkar"
  },
  "قلمی": {
    "bn": "শাস্তি, দণ্ড, সাজা, যন্ত্রণা",
    "ro": "Qalmi"
  },
  "قلوب": {
    "bn": "হৃদয়, মন, অন্তঃকরণ, হৃৎপিণ্ড",
    "ro": "Qlob"
  },
  "قلہ": {
    "bn": "উপবিভাগ নষ্ট করা, নিশ্চিহ্ন করা, ধ্বংস, সর্বনাশ, নাশ",
    "ro": "Qulla"
  },
  "قلیان": {
    "bn": "হুক্কা, হুঁকা",
    "ro": "Qlyan"
  },
  "قلیچ": {
    "bn": "তরবারি, অসি, তলোয়ার, তরোয়াল, পাটি",
    "ro": "Qlica"
  },
  "قلیل": {
    "bn": "অতি অল্পসংখ্যক, গুটিকতক, কতিপয়, কয়েক, সামান্য",
    "ro": "Qlil"
  },
  "قلیم": {
    "bn": "রাজ হংসী, লেখনী, লিখনী, একটি কলম",
    "ro": "قلیم"
  },
  "قم": {
    "bn": "জাতি, সম্প্রদায়, জনগোষ্ঠী",
    "ro": "Qum"
  },
  "قمار": {
    "bn": "জুয়া, দ্যূতক্রীড়া, জুয়াখেলা, বাজি",
    "ro": "Qimar"
  },
  "قماری": {
    "bn": "জুয়া, দ্যূতক্রীড়া, জুয়াখেলা, বাজি",
    "ro": "Qmari"
  },
  "قماریا": {
    "bn": "জুয়া, জুয়া খেলা, দ্যূত, কৈতব, জুয়া",
    "ro": "Qmarya"
  },
  "قماش": {
    "bn": "বিনিশ্চয়, বৈষম্য, বিষমতা, ক্যানভাস, ত্রিপল",
    "ro": "Qmasa"
  },
  "قمچی": {
    "bn": "চাবুক, কঞ্চি, চিকন ডাল, বেত, চাবুক মারার দণ্ড",
    "ro": "Qumchi"
  },
  "قمر": {
    "bn": "চাঁদ, চন্দ্র, শশী, ইন্দু, বিধু",
    "ro": "Qamar"
  },
  "قمری": {
    "bn": "চন্দ্র, চাঁদ, শশী, ইন্দু",
    "ro": "Qamri"
  },
  "قمریاں": {
    "bn": "চাঁদ, চন্দ্র, শশী, ইন্দু",
    "ro": "Qmryan"
  },
  "قمطار": {
    "bn": "সুদ, স্বার্থ, গা, অধিকার, মঙ্গল",
    "ro": "Qmtar"
  },
  "قمقام": {
    "bn": "অবস্থান, স্থান, জায়গা, সাইট",
    "ro": "قمقام"
  },
  "قمیص": {
    "bn": "কামিজ, জামা, কুর্তা, পরিধেয় ঢিলেঢালা জামা, শার্ট",
    "ro": "Qamis"
  },
  "قمیض": {
    "bn": "শার্ট, জামা, কুর্তা",
    "ro": "Qamiz"
  },
  "قناعت": {
    "bn": "অভ্যন্তরস্থ বস্তু, বিষয়বস্তু, তৃপ্তি, শান্তি, আনন্দ",
    "ro": "Qanaat"
  },
  "قند": {
    "bn": "চিনি, শর্করা, চিনি মেশান, মিষ্টদ্রব্য, চৈনিক",
    "ro": "Qand"
  },
  "قنوات": {
    "bn": "খাল, নালা, তালিকা, সারণি",
    "ro": "Qnoat"
  },
  "قنوان": {
    "bn": "আইন, বিধি, নিয়ম, সূত্র, বিধান",
    "ro": "Qnoan"
  },
  "قنوطیت": {
    "bn": "নৈরাশ্যবাদ, হতাশাবাদী মনোভাব, পেসিমিজম, জীবনের নেতিবাচক দৃষ্টিভঙ্গি, বিষাদবাদ",
    "ro": "Qnotit"
  },
  "قنیہ": {
    "bn": "ব্যভিচার, যিনা, অবৈধ সম্পর্ক, পাপাচার, অনাচার",
    "ro": "Qnih"
  },
  "قوارع": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "Qoara"
  },
  "قواعد": {
    "bn": "ব্যাকরণ, কায়দাকানুন, নিয়মাবলী, অনুশাসন",
    "ro": "Qavaa'id"
  },
  "قوافی": {
    "bn": "ছড়া, কবিতার অস্ত্যমিল, মিত্রাক্ষর কবিতা, অনুরূপ ধ্বনি সাদৃশ্য, মিলবিশিষ্ট হওয়া",
    "ro": "Qoafi"
  },
  "قوالب": {
    "bn": "প্রবল আকাঙ্ক্ষা, অভীপ্সা, অনুরোধ, ইচ্ছা, গৌরভ",
    "ro": "Qoalb"
  },
  "قوام": {
    "bn": "ধারাবাহিকতা, সংযোগ, সম্বন্ধ, সম্পর্ক",
    "ro": "Qyoam"
  },
  "قوانین": {
    "bn": "আইন, নিয়ম, বিধিবদ্ধ, কানুনসমূহ, আইনসমূহ",
    "ro": "Qavaanin"
  },
  "قوائم": {
    "bn": "সংবিধান, নিয়ম, কানুন, শাসনতন্ত্র",
    "ro": "Qoaim"
  },
  "قوائے": {
    "bn": "সংগঠিত করা, সংঘবদ্ধ করা, প্রস্তুতি নেওয়া, বন্দোবস্ত করা, বাহিনী",
    "ro": "Qoaye"
  },
  "قوت": {
    "bn": "ধারণক্ষমতা, সামর্থ্য, পদাধিকার, কাজের ফলাফল, আরোপিত প্রভাব",
    "ro": "Qut"
  },
  "قوتیں": {
    "bn": "বাহিনী, সেনাদল, লশকর, সৈন্যদল",
    "ro": "Qotin"
  },
  "قورت": {
    "bn": "এক ঢোক, এক চুমুক",
    "ro": "Qort"
  },
  "قورق": {
    "bn": "নিষিদ্ধ, অবৈধ, প্রতিষিদ্ধ, বলা, কথা বলা",
    "ro": "Qorq"
  },
  "قوس": {
    "bn": "খিলান, ধনুক, তির ধনুক, কামান",
    "ro": "Qaos"
  },
  "قوسی": {
    "bn": "বন্ধনী, তালা, কুলুপ, তালাচাবি",
    "ro": "Qosi"
  },
  "قوسین": {
    "bn": "বন্ধনী, তালা, কুলুপ, তালাচাবি",
    "ro": "Qaosain"
  },
  "قول": {
    "bn": "শব্দ, কথা, বাণী, পদ, উক্তি",
    "ro": "Qaul"
  },
  "قولاً": {
    "bn": "বলা, কথা, বাণী, উক্তি, বিবৃতি",
    "ro": "Qolaan"
  },
  "قولنج": {
    "bn": "প্রধানত প্রাণী ও শিশুদের ব্যক্তিদের ক্ষেত্রে ঠাট্টায় একবারের খাবার . খাওয়ানো, খাওয়ানো, কামড়ানো, টোপ গেলা, যন্ত্রণা দেওয়া",
    "ro": "Qaolanj"
