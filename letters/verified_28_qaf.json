  },
  "قداس": {
    "bn": "পবিত্র, নির্মল, শুদ্ধ, শুচি",
    "ro": "Quddas"
  },
  "قدام": {
    "bn": "পা, পদক্ষেপ, পদ",
    "ro": "Quddam"
  },
  "قدح": {
    "bn": "পেয়ালা, পানপাত্র, কাপ, সৌন্দর্য, বাটি",
