  },
  "قدسیاں": {
    "bn": "অভয়ারণ্য, আশ্রয়স্থল, মসজিদ ইত্যাদি পবিত্র স্থান, ধর্মস্থান",
    "ro": "Qdsyan"
  },
  "قدغن": {
    "bn": "নিষেধাজ্ঞা, বাধা, বাঁধুনি, ছন্দবদ্ধতা",
    "ro": "Qadghan"
  },
  "قدم": {
    "bn": "পদক্ষেপ, গতি, পদসঞ্চালন করা, প্রাচীনত্ব, প্রাচীনতা",
    "ro": "Qadam"
  },
  "قدمباز": {
    "bn": "কদম এ কুশলী, কদম এ অভ্যস্ত, কদমপটু ব্যক্তি",
    "ro": "Qdmbaz"
  },
  "قدمچہ": {
    "bn": "ধাপ, মই, সোপান, সিঁড়ি",
    "ro": "Qadamchah"
  },
  "قدموں": {
    "bn": "ধাপ, মই, সোপান, সিঁড়ি",
    "ro": "Qadmon"
  },
  "قدور": {
    "bn": "আকার, আয়তন, বিস্তার, ভার",
    "ro": "Qdor"
  },
  "قدوس": {
    "bn": "পবিত্র, নির্মল, শুদ্ধ, শুচি",
    "ro": "Quddos"
  },
  "قدوسی": {
    "bn": "পবিত্রতা, শুচিতা, অলঙ্ঘনীয়তা, সতীত্ব",
    "ro": "Qdosi"
  },
  "قدوم": {
    "bn": "উত্তীর্ণ হওয়া, সাবালক হওয়া, সংযোজন, সমাগম, আবির্ভাব",
