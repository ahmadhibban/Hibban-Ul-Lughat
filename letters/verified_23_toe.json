  },
  "طبیعی": {
    "bn": "প্রাকৃতিক, স্বাভাবিক, স্বভাবজাত, পদার্থবিদ্যা সংক্রান্ত",
    "ro": "Tabi'i"
  },
  "طبیعیات": {
    "bn": "পদার্থবিজ্ঞান, পদার্থবিদ্যা, প্রাকৃতিক শক্তিশাস্ত্র, জড় ও শক্তির বিজ্ঞান, ফিজিক্স",
    "ro": "Tabi'iyyaat"
  },
  "طبیعیاتی": {
