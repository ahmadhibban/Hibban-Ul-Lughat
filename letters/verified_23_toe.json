  },
  "طبیبہ": {
    "bn": "চিকিত্সক, ডাক্তার",
    "ro": "طبیبہ"
  },
  "طبیبی": {
    "bn": "মেডিকেল, চিকিৎসা সংক্রান্ত, চিকিৎসাবিজ্ঞানীয়, ডাক্তারি",
