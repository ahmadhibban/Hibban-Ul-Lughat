{
  "طابت": {
    "bn": "স্বাস্থ্য, শারিরীক অবস্থা, সুস্থতা, আরোগ্য",
    "ro": "Tabt"
  },
  "طابع": {
    "bn": "মুদ্রক, প্রকাশক, ছাপাখানার কারিগর, ছাপার মুদ্রণযন্ত্র, প্রকাশনাকর্মী",
    "ro": "Taba"
  },
  "طابق": {
    "bn": "মেঝে, ভূতল, ভূপৃষ্ঠ, মাটির উপরিভাগ",
    "ro": "طابق"
  },
  "طاحن": {
    "bn": "মিল, সামঞ্জস্য, সংগতি, সাদৃশ্য",
    "ro": "Tahin"
  },
  "طاس": {
    "bn": "ধাতুর বা চীনামাটির তৈরি গামলা জাতীয় পাত্র, জলজমা নিম্নভূমি, গোলাকার বা ডিম্বাকৃতি উপত্যকা, নদীর অববাহিকা, অববাহিকা",
    "ro": "Tas"
  },
  "طاسے": {
    "bn": "বাটি, পেয়ালা, পানপাত্র, পিয়ালা",
    "ro": "Tase"
  },
  "طاعات": {
    "bn": "আনুগত্য, বাধ্যতা, বশ্যতা, একনিষ্ঠতা",
    "ro": "Taat"
  },
  "طاعت": {
    "bn": "ধর্মানুরাগ, নিষ্ঠা, উপাসনা, আনুগত্য, বাধ্যতা",
    "ro": "Taat"
  },
  "طاعتی": {
    "bn": "আনুগত্য, বাধ্যতা, বশ্যতা, একনিষ্ঠতা",
    "ro": "Taati"
  },
  "طاعم": {
    "bn": "রেস্তোরাঁ, রেস্টুরেন্ট, ভোজনালয়, হোটেল",
    "ro": "Taim"
  },
  "طاعن": {
    "bn": "আকাশ, অভ্র, নভ, গগন, আশমান",
    "ro": "Tain"
  },
  "طاعون": {
    "bn": "প্লেগ, মহামারি প্লেগ, সংক্রামক মারণব্যাধি, প্লেগরোগ, মহামারির প্রকোপ",
    "ro": "Taa'un"
  },
  "طاعونی": {
    "bn": "প্লেগ, মহামারি প্লেগ, সংক্রামক মারণব্যাধি, প্লেগরোগ",
    "ro": "Taoni"
  },
  "طاق": {
    "bn": "কুলঙ্গি, খিলান, বিজোড়",
    "ro": "Taaq"
  },
  "طاقت": {
    "bn": "ধারণক্ষমতা, সামর্থ্য, পদাধিকার, যোগ্যতা, ক্ষমতা",
    "ro": "Taaqat"
  },
  "طاقتور": {
    "bn": "সক্ষম, শক্তিশালী, দম্ভ করে এমন, প্রাণচঞ্চল, শক্তিমান",
    "ro": "Taaqatvar"
  },
  "طاقتیں": {
    "bn": "ক্ষমতা, শক্তি, বল, সামর্থ্য",
    "ro": "Taaqat"
  },
  "طاقچہ": {
    "bn": "তাক, কুলঙ্গি, খিলান, বিজোড়",
    "ro": "Taqchah"
  },
  "طاقوں": {
    "bn": "কুলুঙ্গি, যথার্থ স্থান, প্রকৃত",
    "ro": "Taqon"
  },
  "طاقہ": {
    "bn": "শক্তি, ক্ষমতা, বল, সামর্থ্য",
    "ro": "Taqah"
  },
  "طالب": {
    "bn": "ছাত্র, শিক্ষার্থী, তালিবুল ইলম, পড়ুয়া",
    "ro": "Talib"
  },
  "طالبہ": {
    "bn": "ছাত্র, শিক্ষার্থী, তালিবুল ইলম, পড়ুয়া",
    "ro": "Talibah"
  },
  "طالبی": {
    "bn": "ছাত্র, শিক্ষার্থী, তালিবুল ইলম, পড়ুয়া",
    "ro": "Talibi"
  },
  "طالبیت": {
    "bn": "ছাত্রত্ব, শিক্ষার্থী, তালিবুল ইলম, পড়ুয়া",
    "ro": "Talibit"
  },
  "طالبیہ": {
    "bn": "ছিঁচকে চুরি করা, লুঠিয়া নিয়ে যাওয়া, লুণ্ঠন করা, লুঠতরাজ, বধ করা",
    "ro": "Talbih"
  },
  "طالح": {
    "bn": "খারাপ, মন্দ, অন্যায়, অসত্‍, বাজে",
    "ro": "Talih"
  },
  "طالش": {
    "bn": "চাওয়া, ভালোবাসা, কামনা করা, ইচ্ছা করা",
    "ro": "طالش"
  },
  "طالع": {
    "bn": "গল্প, কাহিনী, কথা, আখ্যান, অলীক কাহিনী",
    "ro": "Talya"
  },
  "طالق": {
    "bn": "তালাকপ্রাপ্ত, বি বিবাহিত, বি পরিণীত, বিবাহবিচ্ছেদ, দূরত্ব",
    "ro": "Talq"
  },
  "طالون": {
    "bn": "ট্যালন, পাখির বক্রাকার নখর, নখ, নখর",
    "ro": "Talon"
  },
  "طامات": {
    "bn": "দাদা, পিতামহরা, পূর্বপুরুষ, পিতামহ",
    "ro": "Tammat"
  },
  "طامع": {
    "bn": "লোভ, লালসা, প্রবল বাসনা, কামভাব",
    "ro": "Tamya"
  },
  "طامعانہ": {
    "bn": "লোভ, লালসা, প্রবল বাসনা, কামভাব",
    "ro": "Tamyaanah"
  },
  "طامعہ": {
    "bn": "লোভী, লোলুপ, লিপ্সু, লালায়িত, অর্থলোলুপ",
    "ro": "Tamah"
  },
  "طائر": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "Tair"
  },
  "طائرانہ": {
    "bn": "ভাসা ভাসা দৃষ্টি, বিহঙ্গম দৃষ্টি, ওপর ওপর একনজর দেখা",
    "ro": "Taairaana"
  },
  "طائفہ": {
    "bn": "সম্প্রদায়, জনসাধারণ, জনতা, জাতি, দশ",
    "ro": "Taifah"
  },
  "طائی": {
    "bn": "এইভাবে, সুতরাং, দূর পর্যন্ত",
    "ro": "Tai"
  },
  "طاؤس": {
    "bn": "ময়ূর, শিখণ্ডী, ময়ূর পাখি, পুচ্ছধারী রূপবান পক্ষী, পেখম মেলা বিহঙ্গ",
    "ro": "Taaus"
  },
  "طب": {
    "bn": "আদর, সোহাগ, প্রবঞ্চনা করা, ঠকান, আদর করে হাত বোলানো",
    "ro": "Tibb"
  },
  "طبابت": {
    "bn": "ঔষধ, দাওয়াই, ভেষজ, প্রতিষেধক",
    "ro": "Tibabat"
  },
  "طباخ": {
    "bn": "রান্না, বিশেষ রন্ধন প্রণালী",
    "ro": "Tabaka"
  },
  "طباخت": {
    "bn": "রান্না, বিশেষ রন্ধন প্রণালী",
    "ro": "Tibakhat"
  },
  "طباخی": {
    "bn": "রান্না, বিশেষ রন্ধন প্রণালী, রান্না করা, পাক করা",
    "ro": "Tabbakhi"
  },
  "طباشیر": {
    "bn": "চক, মোড়, চার রাস্তার মোড়, চত্বর",
    "ro": "Tbashir"
  },
  "طباع": {
    "bn": "বুদ্ধিমান, বিজ্ঞ, প্রবীণ, বিচক্ষণ, জ্ঞানী",
    "ro": "Tabbaa"
  },
  "طباعت": {
    "bn": "মুদ্রণ, ছাপা, প্রকাশনা, কিতাব মুদ্রণ শিল্প, প্রেসের মুদ্রণকর্ম",
    "ro": "Tabaat"
  },
  "طباعتی": {
    "bn": "মুদ্রিত, প্রকাশিত, ছাপাখানায় মুদ্রিত বই বা পত্রিকা",
    "ro": "Tabaati"
  },
  "طباعی": {
    "bn": "শারীরিক, পদার্থবিদ্যাগত, দৈহিক",
    "ro": "Tabbaai"
  },
  "طباق": {
    "bn": "বড় থালা, ট্রে, পাত্র, রন্ধনপাত্র, থাল",
    "ro": "Tabaaq"
  },
  "طباقی": {
    "bn": "শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ, পরীক্ষার ফলভিত্তিক বিভাগ",
    "ro": "Tabaqi"
  },
  "طبالت": {
    "bn": "ড্রামিং, ঢাক বাজান",
    "ro": "Tbalt"
  },
  "طبانچہ": {
    "bn": "পিস্তল, পিস্তল দিয়া গুলি করা, ছোট আগ্নেয়াস্ত্র, রিভলভার",
    "ro": "Tabanchah"
  },
  "طبائع": {
    "bn": "হাত, হস্ত, দক্ষতা, কর্মী, নির্দেশক কাঁটা",
    "ro": "Tabaya"
  },
  "طباً": {
    "bn": "ঔষধ, ভেষজ, চিকিত্সাশাস্ত্র, চিকিত্সাবিজ্ঞান, ভেষজবিদ্যা",
    "ro": "Tbaan"
  },
  "طبخ": {
    "bn": "রান্না, বিশেষ রন্ধন প্রণালী",
    "ro": "Tabka"
  },
  "طبع": {
    "bn": "খিট্খিটে, অভিমানী, অতি অভিমানী, প্রকৃতি, স্বভাব",
    "ro": "Taba"
  },
  "طبعاً": {
    "bn": "অবশ্যই, স্বভাবত, হ্যাঁ, নিশ্চয়ই",
    "ro": "Tbaan"
  },
  "طبعہ": {
    "bn": "প্রকৃতি, স্বভাব, সৃষ্টি, বংশধারা",
    "ro": "Tabah"
  },
  "طبعی": {
    "bn": "জন্মগত, সহজাত, স্বভাবগত, স্বাভাবিক, স্বভাবসিদ্ধ",
    "ro": "Tabaai"
  },
  "طبعیات": {
    "bn": "পদার্থবিদ্যা, পদার্থবিজ্ঞান, প্রাকৃতিক শক্তিশাস্ত্র, জড় ও শক্তির বিজ্ঞান",
    "ro": "Tabiyat"
  },
  "طبعیہ": {
    "bn": "পদার্থবিদ্যা, পদার্থবিজ্ঞান, প্রাকৃতিক শক্তিশাস্ত্র, জড় ও শক্তির বিজ্ঞান",
    "ro": "Tabiih"
  },
  "طبق": {
    "bn": "আত্মসমর্পণ, বশ্যতাস্বীকার, পদত্যাগ, পরাজয় স্বীকার, ত্যাগ করা",
    "ro": "Tabaq"
  },
  "طبقا": {
    "bn": "শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ, পরীক্ষার ফলভিত্তিক বিভাগ",
    "ro": "Tabqa"
  },
  "طبقات": {
    "bn": "ক্লাস, শ্রেণী, বিভাগ, বর্গ",
    "ro": "Tabqat"
  },
  "طبقاتی": {
    "bn": "ক্লাস, শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ",
    "ro": "Tabqati"
  },
  "طبقچہ": {
    "bn": "ক্লাস, শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ",
    "ro": "Tbqcha"
  },
  "طبقچی": {
    "bn": "ক্লাস, শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ",
    "ro": "Tabaqchi"
  },
  "طبقڑی": {
    "bn": "ক্লাস, শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ",
    "ro": "Tbqri"
  },
  "طبقہ": {
    "bn": "শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ, পরীক্ষার ফলভিত্তিক বিভাগ",
    "ro": "Tabaqa"
  },
  "طبقی": {
    "bn": "ক্লাস, শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ",
    "ro": "Tabqi"
  },
  "طبقے": {
    "bn": "স্তরগুলো, সমাজশ্রেণিসমূহ, গোষ্ঠীগুলো, শ্রেণিভাগ",
    "ro": "Tabaqe"
  },
  "طبل": {
    "bn": "ড্রাম, ঢোল, পিপা, তরল রাখার বড় পাত্র",
