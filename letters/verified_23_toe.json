    "ro": "Tabiiyati"
  },
  "طبیہ": {
    "bn": "ঔষধ, দাওয়াই, ভেষজ, প্রতিষেধক",
    "ro": "Tbih"
  },
  "طپانچہ": {
    "bn": "সাদৃশ্য, চড়, চপেটাঘাত, চাপড়, চপেট",
    "ro": "Tpancha"
