  },
  "زعیمانہ": {
    "bn": "নেতৃত্ব, পরিচালনা, ইমামতি, ইমাম পদ",
    "ro": "Zaimanah"
  },
  "زغال": {
    "bn": "কাঠকয়লা, কয়লা, ভূগর্ভস্থ জীবাশ্ম কয়লা, কার্বন",
    "ro": "Zughal"
  },
  "زفاف": {
    "bn": "বিবাহ, বিয়ে, নিকাহ, শাদি, পরিণয়",
    "ro": "Zfaf"
  },
  "زفیر": {
    "bn": "পশ্চিম থেকে আগত মৃদু সমীর, ফুরফুরে মিঠে হাওয়া, ক্রীড়াবিদের পাতলা ফিনফিনে জার্সি, পোশাক তৈরির পাতলা ফিনফিনে কাপড়",
    "ro": "Zafir"
  },
  "زفیری": {
    "bn": "পশ্চিম থেকে আগত মৃদু সমীর, ফুরফুরে মিঠে হাওয়া, ক্রীড়াবিদের পাতলা ফিনফিনে জার্সি, পোশাক তৈরির পাতলা ফিনফিনে কাপড়",
    "ro": "Zafiri"
  },
  "زقوم": {
    "bn": "ফণীমনসা, বাজে ভাষা, কদুক্তি, অশ্লীলতা, অপবিত্রতা",
    "ro": "Zaqom"
  },
  "زکات": {
    "bn": "গর্ব, অহংকার করা, জাঁকজমক, আড়ম্বর, ঘটা",
    "ro": "Zakaat"
  },
  "زکام": {
    "bn": "অহংকার করা, গর্ব, সর্দি, ঠান্ডা লাগা, শ্লেষ্মা",
    "ro": "Zukam"
  },
  "زکامی": {
    "bn": "সর্দি, ঠান্ডা লাগা, শ্লেষ্মা",
    "ro": "Zukami"
  },
  "زکاوت": {
    "bn": "উপাসনা করা, ধার্মিকতা, কর্তব্যনিষ্ঠা, ভক্তি, ধর্মানুরাগ",
    "ro": "Zkaot"
  },
  "زکریا": {
    "bn": "হযরত জাকারিয়া আলাইহিস সালাম, বনি ইসরাইলের সম্মানিত নবী ও হযরত ইয়াহইয়া আ. এর পিতা",
    "ro": "Zakariyyaa"
  },
  "زکواۃ": {
    "bn": "ইসলামের অন্যতম ফরজ স্তম্ভ, সম্পদের পবিত্রতা বিধানকারী নির্ধারিত দান, দরিদ্রকল্যাণ কর",
    "ro": "Zakoa"
  },
  "زکواة": {
    "bn": "ইসলামের অন্যতম ফরজ স্তম্ভ, সম্পদের পবিত্রতা বিধানকারী নির্ধারিত দান",
    "ro": "Zkoa"
  },
  "زکوٰة": {
    "bn": "ইসলামের অন্যতম ফরজ স্তম্ভ, সম্পদের পবিত্রতা বিধানকারী নির্ধারিত দান",
    "ro": "Zkoaa"
  },
  "زکٰوة": {
    "bn": "ইসলামের অন্যতম ফরজ স্তম্ভ, সম্পদের পবিত্রতা বিধানকারী নির্ধারিত দান",
    "ro": "Zkaao"
  },
  "زلازل": {
    "bn": "ভূমিকম্প, ভূকম্পন, ভূকম্প, ধরণীকম্পন",
    "ro": "Zlazl"
  },
  "زلزال": {
    "bn": "ভূমিকম্প, ভূকম্পন, ভূকম্প, ধরণীকম্পন",
    "ro": "Zilzal"
  },
  "زلزلا": {
    "bn": "ভূমিকম্প, ভূকম্পন, ভূকম্প, ধরণীকম্পন",
    "ro": "Zlzla"
  },
  "زلزلانا": {
    "bn": "ঝাঁকান, বিস্ফারিত, বিস্ফুরিত",
    "ro": "Zalzalana"
  },
  "زلزلہ": {
    "bn": "ধন, সম্পদ, খুব বেশী সংখ্যা বা পরিমাণ, ভূমিকম্প, ভূকম্পন",
    "ro": "Zalzala"
  },
  "زلزلے": {
    "bn": "ভূমিকম্পগুলো, ভূকম্পনসমূহ, মাটির প্রকম্পনগুলো",
    "ro": "Zalzale"
  },
  "زلف": {
    "bn": "কুঞ্চিত কুন্তল, অলকগুচ্ছ, চূর্ণকুন্তল, অলক, চুল",
    "ro": "Zulf"
  },
  "زلفی": {
    "bn": "ভণ্ড, কপটাচারী, কেশগুচ্ছ, চুল, অলক",
    "ro": "Zulfi"
  },
  "زلفیں": {
    "bn": "ঘ্রাণ, সুবাসিত করা, গন্ধ, সুবাস",
    "ro": "Zulf"
  },
  "زلق": {
    "bn": "পিচ্ছিল, হড়হড়ে, ঝক্মকে, তেলচিটে",
    "ro": "Zalaq"
  },
  "زلل": {
    "bn": "লজ্জা, শরম, হায়া, সংকোচ, শালীনতাবোধ",
    "ro": "Zalal"
  },
  "زلوں": {
    "bn": "জেলাগুলি, জেলার",
    "ro": "Zlon"
  },
  "زمام": {
    "bn": "উৎফুল্ল, প্রসন্ন, আনন্দদাযক, প্রফুল্ল, খুশি",
    "ro": "Zamam"
  },
  "زمان": {
    "bn": "সময়, বার, কাল, মেয়াদ, বেলা",
    "ro": "Zaman"
  },
  "زمانہ": {
    "bn": "যুগ, কাল, সময়, কালখণ্ড",
    "ro": "Zamaana"
  },
  "زمانی": {
    "bn": "সময়, কাল, সুযোগ, বেলা",
    "ro": "Zamani"
  },
  "زمانیت": {
    "bn": "সময়ানুবর্তিতা, সময়নিষ্ঠা, পাটি",
    "ro": "Zamaniit"
  },
  "زمانیہ": {
    "bn": "সময়কাল, কাল, দিনসমূহ, দিবসসমূহ",
    "ro": "Zamaniih"
  },
  "زمانے": {
    "bn": "যুগসমূহ, কালসমূহ, শতাব্দীসমূহ, কালের আবর্তন, ইতিহাসধারা",
    "ro": "Zamaane"
  },
  "زماں": {
    "bn": "কাল, সময়, যুগ, ঋতু",
    "ro": "زماں"
  },
  "زمرد": {
    "bn": "পান্না, মরকত, উজ্জ্বল সবুজ মূল্যবান রত্নবিশেষ, পান্না পাথর",
    "ro": "Zumurrud"
  },
  "زمردی": {
    "bn": "পান্না, মরকত, উজ্জ্বল সবুজ মূল্যবান রত্নবিশেষ, পান্না পাথর",
    "ro": "Zumurrdi"
