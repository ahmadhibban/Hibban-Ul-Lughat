  },
  "زرخرچ": {
    "bn": "ব্যয়, খরচ, কেবল, শুধু",
    "ro": "Zarkharca"
  },
  "زرخرید": {
    "bn": "দর কষাকষি, কারবারী, দরকষাকষি সংক্রান্ত, বিক্রেতা",
    "ro": "Zarkharid"
  },
  "زرخریدار": {
    "bn": "সমৃদ্ধ, আবাদ, জনবহুল, উন্নত",
    "ro": "Zarkharidar"
  },
  "زرخیز": {
    "bn": "ঘটনাক্রমে, দৈবাৎ, অকস্মাৎ, অবিলম্বে, হঠাৎ",
    "ro": "Zarkhiz"
  },
  "زرخیزی": {
    "bn": "বোঁচকা, গাঁঠ, গাঁঠরি, পাঁজা, উর্বরতা",
    "ro": "Zarkhizi"
  },
  "زرد": {
    "bn": "মুকুল, সৌন্দর্য, পুষ্প, বর্ণহীন, নির্বোধ",
    "ro": "Zard"
  },
  "زردا": {
    "bn": "মিষ্টি সুগন্ধি পোলাও, জাফরানি জর্দা, মিষ্টি তামাক পাতা",
    "ro": "Zarda"
  },
  "زردار": {
    "bn": "স্বর্ণ এর অধিকারী, স্বর্ণধারী, স্বর্ণযুক্ত, স্বর্ণসম্পন্ন ব্যক্তি",
    "ro": "Zrdar"
  },
  "زردالو": {
    "bn": "খুবানি, খোবানি, এপ্রিকট, এপ্রিকটস",
    "ro": "Zrdalo"
  },
  "زردشتی": {
    "bn": "জরথুষ্ট্রবাদ, জরাথুরষ্ট্র কর্তৃক প্রবর্তিত ও জেন্দ অবেসতায় বর্ণিত প্রাচীন পারস্যবাসীর অগ্নি উপাসনামূলক ধর্ম",
    "ro": "Zrdshti"
  },
  "زردک": {
    "bn": "প্রজ্বলিত অবস্থা, দাহন, আগুন, শিখা, অগ্নিকাণ্ড",
    "ro": "Zrdk"
  },
  "زردوزی": {
    "bn": "জরির কাজ, সোনা রুপার সুতোর সূচিকর্ম, কারুশিল্প",
    "ro": "Zardozi"
  },
  "زردہ": {
    "bn": "মিষ্টি সুগন্ধি পোলাও, জাফরানি জর্দা, মিষ্টি তামাক পাতা",
    "ro": "Zardah"
  },
  "زردی": {
    "bn": "বাকশক্তিহীন, ভাষাহীন, হতবাক, স্বল্পভাষী, নির্বোধ",
    "ro": "Zardi"
  },
  "زرسفید": {
    "bn": "সাদা, শ্বেত, শুভ্র, ধবল",
    "ro": "Zrsfid"
  },
  "زرعستان": {
    "bn": "কৃষি, কৃষিবিদ্যা ও পশুপালন, চাষবাস, চাষাবাদ",
    "ro": "Zarasitan"
  },
  "زرعہ": {
    "bn": "কৃষি, চাষাবাদ, কৃষিকাজ, ফসল উৎপাদন, কৃষিকর্ম",
    "ro": "Zarah"
  },
  "زرعی": {
    "bn": "কৃষি, চাষাবাদ, কৃষিকাজ, ফসল উৎপাদন, কৃষিকর্ম",
    "ro": "Zarai"
  },
  "زرق": {
    "bn": "হরণ, জোচ্চুরি, জুয়াচুরি, প্রতারণা, জালিয়াতি",
    "ro": "Zarq"
  },
  "زرکار": {
    "bn": "আলিঙ্গন করা, আলিঙ্গন, দৃঢ়ভাবে আলিঙ্গন করা, বুকে জড়াইয়া ধরা, জহুরি",
    "ro": "Zarkar"
  },
  "زرکاری": {
    "bn": "ভৃত্য, চাকরবাকর, সেবক, খাদেম",
    "ro": "Zarkari"
  },
  "زرکشی": {
    "bn": "উর্বরতা, উৎপাদনশীলতা, প্রচুর ফলন ক্ষমতা",
    "ro": "Zarkashi"
  },
  "زرکنار": {
    "bn": "স্বর্ণকার, স্যাকরা, সোনা কারিগর, অলঙ্কার প্রস্তুতকারক",
    "ro": "Zrknar"
  },
  "زرگر": {
    "bn": "স্বর্ণকার, সোনা রূপার কারিগর, সেকরা",
