  },
  "زرگری": {
    "bn": "পোকার নামে এক ধরনের তাসখেলার বাজিবিশেষ, পূর্ব, কোনো কঠিন বস্তুর সমতল বা প্রায় সমতল বর্হির্ভাগ বা উপরিভাগ ., পাশ, স্বর্ণকারের পেশা",
    "ro": "Zargari"
  },
  "زرگوں": {
    "bn": "সাফল্য, সফলতা, সিদ্ধি, জয়, সমৃদ্ধি",
    "ro": "Zrgon"
  },
  "زرمطالبہ": {
    "bn": "দাবি, ঋণ, খাজনা, বাকিবকেয়া, চাহিদা",
    "ro": "Zarimutalibah"
  },
  "زرمین": {
    "bn": "জার্মান ভাষা, জার্মান অধিবাসী, জার্মানির মানুষ",
    "ro": "زرمین"
  },
  "زرنقد": {
    "bn": "টাকা, মুদ্রা, অর্থকড়ি, অর্থ",
    "ro": "Zarinaqd"
  },
  "زرنگار": {
    "bn": "সোনালি কারুকার্যময়, স্বর্ণখচিত, জারুল কাজ",
    "ro": "Zarnigar"
  },
  "زرنگاری": {
    "bn": "স্বর্ণকার, স্যাকরা, সোনা কারিগর, অলঙ্কার প্রস্তুতকারক",
    "ro": "Zarnigari"
  },
  "زرنیخ": {
    "bn": "আর্সেনিক, সোমেলক্ষার, তীব্র বিষাক্ত ধাতব মৌল",
    "ro": "Zrnika"
  },
  "زرہ": {
    "bn": "বর্ম, রক্ষাকবচ, কঁচুক",
    "ro": "Zirah"
  },
  "زرین": {
    "bn": "স্বর্ণমণ্ডলী, স্বর্ণগণ, স্বর্ণবৃন্দ, সকল স্বর্ণ",
    "ro": "زرین"
  },
  "زرینی": {
    "bn": "গোল্ডেন, সোনার তৈরি, কাঞ্চননির্মিত, স্বর্ণময়, স্বর্ণসমৃদ্ধ",
    "ro": "Zarini"
  },
  "زریں": {
    "bn": "স্বর্ণ, সোনা, অর্থ, ধনদৌলত",
    "ro": "Zarin"
  },
  "زشت": {
    "bn": "অঙ্গবিহীন, অঙ্গহীন, চতুর্দিকে ছড়িয়ে পড়া বা ছড়ানো, ভিন্ন ভিন্ন স্থানে পাঠানো, বিক্ষিপ্ত করা",
    "ro": "Zisht"
  },
  "زشتی": {
    "bn": "জঘন্য, ঘৃণ্য, কদর্য, নোংরা",
    "ro": "Zshti"
  },
  "زعاف": {
    "bn": "দুর্বলতা, ক্ষীণতা, অক্ষমতা, অপারগতা",
    "ro": "Zaaf"
  },
  "زعفران": {
    "bn": "কেশর, সুগন্ধি জাফরান ফুল, মূল্যবান লাল রঙের মসলা ও রঞ্জক পদার্থ",
    "ro": "Za'fraan"
  },
  "زعفرانی": {
    "bn": "জাফরান রঙের, জাফরানযুক্ত, সোনালি হলুদ",
    "ro": "Za'fraani"
  },
  "زعما": {
    "bn": "শুক্রবার, জুমার দিন, ইসলামের পবিত্র দিন",
    "ro": "Zama"
  },
  "زعنفہ": {
    "bn": "উইং, ডানা, দল, পাখা, উড্ডয়ন",
    "ro": "Zyanifah"
  },
  "زعوم": {
    "bn": "অভিযোগ, অনুযোগ, নালিশ, অপবাদ",
    "ro": "Zaom"
  },
  "زعیم": {
    "bn": "নেতা, সর্দার, পথপ্রদর্শক, প্রধান",
