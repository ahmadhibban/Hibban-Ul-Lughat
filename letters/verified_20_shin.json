  },
  "شوربہ": {
    "bn": "ঝোল, সুরুয়া, স্যুপ, গরম পুষ্টিকর তরল খাবার",
    "ro": "Shorba"
  },
  "شورپ": {
    "bn": "স্যুপ, সুরুয়া, সুপ, ঝোল",
