  },
  "شیخ": {
    "bn": "পরিবার প্রধান, আরব উপজাতি, কর্তৃত্বপরায়ণ স্বামী, কর্তৃত্বপরায়ণ প্রেমিক, গ্রামের প্রধান",
    "ro": "Shekh"
  },
  "شیخی": {
    "bn": "গর্ব, অহংকার করা, গর্ব করা, জাঁক, অহংকার",
    "ro": "Shekhi"
  },
