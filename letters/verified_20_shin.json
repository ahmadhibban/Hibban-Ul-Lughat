  },
  "شواغل": {
    "bn": "পেশা, জীবিকা, কাজ, ব্যবসা",
    "ro": "Shoaghl"
  },
  "شوال": {
    "bn": "মগ্নচড়া, দল, গোষ্ঠী, সমাবেশ",
