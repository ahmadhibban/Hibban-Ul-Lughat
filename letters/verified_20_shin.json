  },
  "شہرت": {
    "bn": "খ্যাতি, সুনাম, সুযশ, প্রসিদ্ধি, নামডাক",
    "ro": "Shuhrat"
  },
  "شہردار": {
    "bn": "পক্ষিশিকারি, পক্ষিমার, জালিক, শাকুনিক, জালিয়া",
    "ro": "Shhrdar"
  },
  "شہرگرد": {
    "bn": "পদব্রজে ভ্রমণ, টহল, ভবঘুরে লোক, নির্দিষ্ট গমনপথ মালবাহী জাহাজ, পদব্রজে গমন করা",
    "ro": "Shhrgrd"
  },
  "شہرہ": {
    "bn": "নগর, নগরী, জনপদ, পৌর এলাকা",
    "ro": "Shuhrah"
  },
  "شہری": {
    "bn": "নাগরিক, শহরবাসী, পৌর",
    "ro": "Shahri"
  },
  "شہریت": {
    "bn": "নাগরিকত্ব, জাতীয়তা, সিভিল রাইটস, কোনো রাষ্ট্রের বৈধ নাগরিকের অধিকার, দেশের অধিবাসিত্ব",
    "ro": "Shahriyat"
  },
  "شہزاد": {
    "bn": "যুবরাজ, রাজকুমার, রাজপুত্র",
    "ro": "Shhzad"
  },
  "شہزادہ": {
    "bn": "রাজকুমার, রাজার পুত্র, যুবরাজ, রাজপুত্র",
    "ro": "Shahzaada"
  },
  "شہزادی": {
    "bn": "রাজকুমারী, রাজার কন্যা, রাজকন্যা",
    "ro": "Shahzaadi"
  },
  "شہزادے": {
    "bn": "রাজপুত্র, রাজকুমার, যুবরাজ",
    "ro": "Shhzade"
  },
  "شہلا": {
    "bn": "নীল নয়না, আকর্ষণী কাজলনয়না নারী, সুরভিত নয়নযুক্তা রমণী",
    "ro": "Shahlaa"
  },
  "شہنشاہ": {
    "bn": "রাজাধিরাজ, সম্রাট, মহারাজাধিরাজ, বাদশাহদের বাদশাহ, পরম পরাক্রমশালী শাসক",
    "ro": "Shahanshaah"
  },
  "شہوانی": {
    "bn": "যৌনতা, সেক্স, নর নারীর দৈহিক সম্পর্ক, প্রজনন জৈবিক ক্রিয়া",
    "ro": "Shahoani"
  },
  "شہوت": {
    "bn": "ক্ষুধা, খাত্তয়ার ইচ্ছা, ব্যসন, প্রবৃত্তি, খাই",
    "ro": "Shahoat"
  },
  "شہود": {
    "bn": "মধু, মৌরস, মধুরস, খাঁটি মধু",
    "ro": "Shuhod"
  },
  "شہودی": {
    "bn": "অন্তর্দৃষ্টি, স্বজ্ঞা, অনুভূতি, সংস্কার, সুচতুর অনুমান",
    "ro": "Shhodi"
  },
  "شہور": {
    "bn": "নগর, নগরী, জনপদ, পৌর এলাকা",
    "ro": "Shhor"
  },
  "شہید": {
    "bn": "শহীদরূপে হত্যা করা, শহীদরূপে হত্যা সম্পাদন করা, শহীদরূপে হত্যা সাধন করা",
    "ro": "Shahid"
  },
  "شہیدوں": {
    "bn": "শহীদদের, আল্লাহর পথে আত্মোৎসর্গকারী, অমর বীর",
    "ro": "Shahid"
  },
  "شہیدی": {
    "bn": "শহীদত্ব, সাক্ষ্য, আত্মোৎসর্গ",
    "ro": "Shhidi"
  },
  "شہیر": {
    "bn": "প্রসিদ্ধ, বিখ্যাত, সুপরিচিত, চমত্কার, প্রখ্যাত",
    "ro": "Shhir"
  },
  "شیاد": {
    "bn": "মিথ্যা বলা, অসত্য বর্ণনা করা, মিথ্যা বর্ণনা করা",
    "ro": "Shyad"
  },
  "شیاطین": {
    "bn": "ভূত, প্রেতাত্মা, অতৃপ্ত আত্মা, এবং অতীত",
    "ro": "Shyatin"
  },
  "شیٹ": {
    "bn": "বিছানার চাদর, চাদর, গায়ের চাদর, আবরণ",
