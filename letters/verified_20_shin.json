  },
  "شحیم": {
    "bn": "চর্বি, মেদ, স্নেহপদার্থ, চর্বিজাতীয় পদার্থ",
    "ro": "Shhim"
  },
  "شخص": {
    "bn": "উদ্ভাসক, ব্যক্তি, লোক, স্বর্গীয় প্রাণী, কাহারও দেহ",
    "ro": "Shakhs"
  },
  "شخصی": {
    "bn": "ব্যক্তিগত, নিজস্ব, বেসরকারি",
