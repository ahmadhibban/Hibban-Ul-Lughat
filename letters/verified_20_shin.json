  },
  "شخصیات": {
    "bn": "ব্যক্তিত্ব, চরিত্র, মর্যাদা, অস্তিত্ব",
    "ro": "Shakhsyat"
  },
  "شخصیت": {
    "bn": "নিজস্বতা, স্বতন্ত্র অস্তিত্ব, ব্যক্তিতা, ব্যক্তিবৈশিষ্ট্য, প্রখর ব্যক্তিস্বাতন্ত্র্য",
    "ro": "Shakhsiyat"
  },
  "شدائد": {
