  },
  "شوریدہ": {
    "bn": "সংবিগ্ন, উপদ্রুত, পরিণামচিন্তাশীল, উন্মত্ত, ব্যাকুল",
    "ro": "Shorida"
  },
  "شوریہ": {
    "bn": "সাহসিকতা, সাহস, শৌর্য, পরাক্রম, দুঃসাহস",
    "ro": "Shorih"
  },
  "شورےٰ": {
    "bn": "গোলমাল, শব্দ, হৈচৈ, রব, নাদ",
    "ro": "Shoreaa"
  },
  "شوشہ": {
    "bn": "অতি ক্ষুদ্র অংশ বা ভাগ, দলিলের ধারা বা শর্ত, অতি ক্ষুদ্র পদার্থ, কণা, কণিকা",
    "ro": "Shoshah"
  },
  "شوق": {
    "bn": "ক্ষুধা, প্রবল আকাঙ্ক্ষা, অভীপ্সা, অনুরোধ, ইচ্ছা",
    "ro": "Shauq"
  },
  "شوقین": {
    "bn": "কোনো বিদ্যা বা শিল্পের শৌখিন চর্চাকারী, অপেশাদার খেলোয়াড, কোনো কিছুতে অপটু বা কাঁচা লোক, অপেশাদার, অত্যন্ত আগ্রহী ব্যক্তি",
    "ro": "Shaoqin"
  },
  "شوقینی": {
    "bn": "পেশা, কাজ, ব্যস্ততা",
    "ro": "Shaoqini"
  },
  "شوقیہ": {
    "bn": "অপেশাদার, জনসাধারণের, প্রসব করা",
    "ro": "Shaoqiih"
  },
  "شوکھ": {
    "bn": "ক্ষুদ্র অথচ শক্তিশালী ও চটপটে ঘোড়া, শেখর পেশা, খোশখেয়াল",
    "ro": "Shoka"
  },
  "شومیت": {
    "bn": "অর্থলালসা, অর্থগৃধ্নুত, অর্থলিপ্সা, অর্থলোভ, লোলুপতা",
    "ro": "Shomit"
  },
  "شونت": {
    "bn": "খুবখারাপি রং, ম্যাজেন্টা রঙ্, লাল, লাল রঙের, রক্তবর্ণ",
    "ro": "Shont"
  },
  "شوہر": {
    "bn": "স্বামী, পতি, ভর্তা, জীবনসঙ্গী, ভাতার",
    "ro": "Shauhar"
  },
  "شویت": {
    "bn": "শুভ্রতা, ধবলিমা, উজ্জ্বলতা, নির্মলতা",
    "ro": "Shoit"
  },
  "شہ": {
    "bn": "রাজা, প্রবর্তনা, উত্তেজন, উত্তেজিতকরণ, উত্তেজক",
    "ro": "Shah"
  },
  "شہاب": {
    "bn": "উল্কা, জ্বলন্ত উল্কাপিণ্ড, উজ্জ্বল নক্ষত্রখসা, তারার আগুন",
    "ro": "Shahab"
  },
  "شہابی": {
    "bn": "উল্কা, জ্বলন্ত উল্কাপিণ্ড, উজ্জ্বল নক্ষত্রখসা, তারার আগুন",
    "ro": "Shhabi"
  },
  "شہادت": {
    "bn": "সাক্ষ্য, প্রমাণ, প্রামাণিক সাক্ষ্য, প্রামাণিক বিবৃতি, প্রামাণিক এজাহার",
    "ro": "Shahaadat"
  },
  "شہامت": {
    "bn": "সাহসিকতা, সাহস, বদ্যনতা, দানশীলতা, উদারতা",
    "ro": "Shhamt"
  },
  "شہباز": {
    "bn": "রাজবাজপাখি, হযরত লাল শাহবাজ কালান্দার",
