  },
  "شوری": {
    "bn": "গোলমাল, শব্দ, হৈচৈ, রব, নাদ",
    "ro": "Shoraai"
  },
  "شوریت": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
