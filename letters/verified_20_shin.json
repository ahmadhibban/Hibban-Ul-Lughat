  },
  "شواہد": {
    "bn": "প্রমাণ, নিদর্শন, সাক্ষ্য, আয়াত",
    "ro": "Shaoahid"
  },
  "شوبھ": {
    "bn": "সৌন্দর্য, রূপ, লাবণ্য, জিনাত",
    "ro": "Shoba"
  },
  "شوبھنا": {
    "bn": "শোভন, সুন্দর, মার্জিত, নিকষিত",
