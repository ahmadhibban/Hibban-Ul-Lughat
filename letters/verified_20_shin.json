  },
  "شورٹ": {
    "bn": "সংক্ষিপ্ত, সংক্ষেপিত, সারসংক্ষেপ, মোটাদাগে",
    "ro": "Short"
  },
  "شورش": {
    "bn": "চাগাড়, ক্ষোভ, অশান্তি, আলোড়ন, চঁচলতা",
    "ro": "Shorisa"
  },
  "شوروشر": {
    "bn": "উত্তেজিত তৎপরতা, ছুটাছুটি, দাবি, বিক্ষোভ, কলরব",
    "ro": "Shoroshr"
  },
  "شورہ": {
    "bn": "উপদেশ, পরামর্শ, শিক্ষা, নসিহত",
