  },
  "شہتیر": {
    "bn": "কড়িকাঠ, জাহাজের সবচেয়ে চওড়া অংশ, তুলাদণ্ড, আলোকরশ্মি, মরীচি",
    "ro": "Shahtir"
  },
  "شہد": {
    "bn": "পুষ্পমধু, প্রিয়সম্বোধনবিশেষ, মধু, খাঁটি মধু, মৌরস",
    "ro": "Ahd"
  },
  "شہدا": {
    "bn": "মাটি এদিক ওদিক করে জমি সমান করবার একই রকম যন্ত্র, লম্বা হাতল দেওয়া দাঁতালো যন্ত্রের সাহায্যে মসৃণ করা, কেতাদুরস্ত অসচ্চরিত্র ব্যক্তি, লম্পট, নটবর",
    "ro": "Shuhadaa'"
  },
  "شہداپن": {
    "bn": "শাহাদাত, শহীদত্ব, সাক্ষ্য, আত্মোৎসর্গ",
