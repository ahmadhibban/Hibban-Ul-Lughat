  "شوخ": {
    "bn": "সাহসী, দুঃসাহসিক, জোরালো, উদ্ধত, বেপরোয়া",
    "ro": "Shoka"
  },
  "شوخی": {
    "bn": "প্রণয়লীলার ভান, পুরুষের মনভোলানো আচরণ, ছিনালি, জীবদেহনিঃসৃত রস, মানসিক অবস্থা",
    "ro": "Shokhi"
  },
  "شور": {
    "bn": "চাগাড়, ক্ষোভ, অশান্তি, আলোড়ন, চঁচলতা",
