  },
  "شنگل": {
    "bn": "চমত্কার, প্রশংসনীয়, সুন্দর, পরিষ্কার পরিচ্ছন্ন, বেশ মনোরম",
    "ro": "Shngl"
  },
  "شنوا": {
    "bn": "শ্রবণকারী, শ্রোতা, শ্রোতা, শ্রবণ, শ্রবণ শক্তি",
    "ro": "Shnoa"
  },
  "شنوائی": {
    "bn": "শ্রবণ, শ্রবণ শক্তি, শ্রুতি, শ্রবণশক্তি, কান দিয়ে শোনার অনুভূতি",
    "ro": "Shanoai"
  },
  "شنید": {
    "bn": "শ্রবণ, শ্রবণশক্তি, কান দিয়ে শোনার অনুভূতি",
    "ro": "Shnid"
  },
  "شنیدہ": {
    "bn": "শ্রবণ, শ্রবণশক্তি, শোনা, কান দিয়ে শোনার অনুভূতি",
    "ro": "Shunidah"
  },
  "شنیع": {
    "bn": "লজ্জা, শরম, হায়া, সংকোচ, শালীনতাবোধ",
