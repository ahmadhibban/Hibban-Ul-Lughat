  },
  "وکول": {
    "bn": "অ্যাডভোকেট, অধিবক্তা, প্রবক্তা, ওকালতি করা",
    "ro": "Okol"
  },
  "وکیع": {
    "bn": "অ্যাডভোকেট, অধিবক্তা, প্রবক্তা, ওকালতি করা, উকিল",
    "ro": "Okya"
