  },
  "وضاح": {
    "bn": "ব্যাখ্যা, বিশদ বিবরণ, বিশ্লেষণ, তাফসীর, অর্থপ্রকাশ",
    "ro": "Ozah"
  },
  "وضاحت": {
    "bn": "শোধন, শোধন, অমলতা, নির্মলতা, স্পষ্টতা",
    "ro": "Ozaht"
  },
  "وضاعت": {
    "bn": "শর্ত, অবস্থা, পরিস্থিতি, সামাজিক পদমার্যাদা, নির্ধারণ করা",
    "ro": "Ozaat"
  },
  "وضع": {
    "bn": "গঠন, বিন্যাস, অবস্থা, আকৃতি, চালচলন",
