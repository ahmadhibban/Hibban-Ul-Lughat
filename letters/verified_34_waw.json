  },
  "وضعدار": {
    "bn": "কেতাদস্তুর, প্রথানুযায়ী, রেওয়াজ অনুসারী, ফ্যাশনেবল, কেতাদুরস্ত",
    "ro": "Ozadar"
  },
  "وضعی": {
    "bn": "পদবী, নিয়োগ, নাম, উপাধি",
