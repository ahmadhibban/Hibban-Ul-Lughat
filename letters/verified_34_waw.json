{
  "وا": {
    "bn": "আবর, পুনরায়, পক্ষান্তরে, অধিকন্তু, প্রত্যুত্তরে",
    "ro": "Vaa"
  },
  "وابست": {
    "bn": "অধিভুক্তি, সংযুক্তিকরণ, অন্তর্ভুক্তি, সংযোজন",
    "ro": "Oabst"
  },
  "وابستگی": {
    "bn": "সংযোগ, যোজন, সংযোগসাধন, সংযুক্তি, সম্পর্ক",
    "ro": "Vaabastagi"
  },
  "وابستہ": {
    "bn": "সংযুক্ত, যুক্ত, জড়িত, সম্বদ্ধ, অনুবন্ধী",
    "ro": "Oabastah"
  },
  "واپس": {
    "bn": "ফেরত, ফিরে, প্রত্যাবর্তন, পেছনের দিকে, পুনরায়",
    "ro": "Vaapas"
  },
  "واپسی": {
    "bn": "অপসারিত, অপগত, পশ্চাত্পদ, প্রত্যাবর্তন, ফেরত আসা",
    "ro": "Vaapsi"
  },
  "واپسین": {
    "bn": "সর্বশেষ, অবশিষ্ট, একেবারেই কাম্য নয়, অন্তিম, সর্বাধুনিক",
    "ro": "Oapsin"
  },
  "واپسیں": {
    "bn": "সর্বশেষ, অবশিষ্ট, একেবারেই কাম্য নয়, অন্তিম, সর্বাধুনিক",
    "ro": "Oapsin"
  },
  "واپل": {
    "bn": "বকবক করা, বকবকনি, কেইকবিশেষ, বাজে বকা",
    "ro": "Oapl"
  },
  "وات": {
    "bn": "ভাটা, হ্রাস, মন্দা, অবনতি",
    "ro": "Oat"
  },
  "واثق": {
    "bn": "সুদৃঢ়, বিশ্বাসী, নিশ্চিত, প্রামাণ্য, নির্ভরকারী",
    "ro": "Oasiq"
  },
  "واثقہ": {
    "bn": "বিশ্বস্ত, সৎ, আস্থাভাজন, আমানতদার",
    "ro": "واثقہ"
  },
  "واجب": {
    "bn": "বাধ্যতামূলক, কার্যভারপ্রাপ্ত ব্যক্তি, আদেশপ্রাপ্ত ব্যক্তি, আদেশ, কার্যভার",
    "ro": "Vaajib"
  },
  "واجبات": {
    "bn": "দায়বদ্ধতা, দায়, কর্জ, কর্তব্যবন্ধন",
    "ro": "Oajbat"
  },
  "واجبی": {
    "bn": "গ্রাহ্য, গ্রহণযোগ্য, বিবেচনার যোগ্য, ন্যায়বান, ঠিক",
    "ro": "Oajibi"
  },
  "واجد": {
    "bn": "অস্তিত্ববান, লাভকারী, আবিষ্কারক, অধিকারী ব্যক্তি",
    "ro": "واجد"
  },
  "واچ": {
    "bn": "ঘড়ি, পাহারা, অনুসন্ধান, প্রহরী, দেখাশোনা",
    "ro": "Oaca"
  },
  "واچمین": {
    "bn": "প্রহরী, দারোয়ান, পাহারাদার",
    "ro": "Oachmin"
  },
  "واحد": {
    "bn": "এক, একক, অদ্বিতীয়, অনন্য, একলা",
    "ro": "Vaahid"
  },
  "واحداً": {
    "bn": "এককভাবে, কেবলমাত্র",
    "ro": "Oahdaan"
  },
  "واحدیت": {
    "bn": "একত্ববাদ, একত্ব, তাওহিদ, পরম ঐশী একতা",
    "ro": "Oahdit"
  },
  "وادہ": {
    "bn": "প্রতিশ্রুতি, প্রতিশ্রুতি দেওয়া কথা দেওয়া, অঙ্গীকার, প্রতিজ্ঞা",
    "ro": "Oada"
  },
  "وادی": {
    "bn": "অবাধ্যতা, অভ্যাস, স্বভাব, প্রকৃতি, গোঁ",
    "ro": "Vaadi"
  },
  "وار": {
    "bn": "শরসন্ধান করা, লক্ষ্যের দিকে বন্দুক প্রভৃতি নিশানা করা, তাগ করা, টিপ করা, কাউকে লক্ষ্য করে বা কারো উদ্দেশে কিছু বলা বা ব্যবস্থা গ্রহণ করা",
    "ro": "Vaar"
  },
  "وارا": {
    "bn": "সাশ্রয়কারী, লাঘবকারী, রক্ষা, ভারা, উচ্চ মাচান",
    "ro": "Oara"
  },
  "وارث": {
    "bn": "উত্তরাধিকারী, দাবিদার, স্বত্বাধিকারী",
    "ro": "Vaaris"
  },
  "وارثہ": {
    "bn": "উত্তরাধিকারী, স্বত্বাধিকারী, বংশধর",
    "ro": "وارثہ"
  },
  "وارثی": {
    "bn": "উত্তরাধিকার, পৈতৃক সম্পদ, ঐতিহ্য",
    "ro": "Oarsi"
  },
  "وارد": {
    "bn": "সংঘটিত, উপনীত, আগত, হাজির, ঘটনা",
    "ro": "Vaarid"
  },
  "واردات": {
    "bn": "অভিজ্ঞতা, অনুভব, পরিচয়, অভিজ্ঞতা লব্ধ বস্তু, ভূয়োদর্শন",
    "ro": "Oaridat"
  },
  "وارڈ": {
    "bn": "পাড়া, মহল্লা, এলাকা",
    "ro": "Oard"
  },
  "وارڈن": {
    "bn": "প্রহরী, প্রধান কর্মচারী, পাহারাদার, চৌকিদার",
    "ro": "Oardn"
  },
  "وارستہ": {
    "bn": "মুক্ত, স্বাধীন, অবাধ, বাধাবন্ধহীন, বন্ধনমুক্ত",
    "ro": "Oarastah"
  },
  "وارفتگی": {
    "bn": "আত্মহারা ভাব, গভীর প্রেমাবেগ, বিহ্বলতা, আত্মমগ্নতা",
    "ro": "Oaraftagi"
  },
  "وارفتہ": {
    "bn": "উত্পথ, নষ্ট, ধ্বংসপ্রাপ্ত, নিলীন, খোয়া গিয়াছে এমন",
    "ro": "Oaraftah"
  },
  "وارن": {
    "bn": "বলিদান, উৎসর্গ, শিকারের পশুর প্রজনন স্থান, ঘনবসতিপূর্ণ বস্তি",
    "ro": "Oaran"
  },
  "وارنٹ": {
    "bn": "নিশ্চয় করা, নিশ্চয় করে বলা, নির্বিঘ্ন করা, ক্ষমতা দেওয়া, সমর্থন করা",
    "ro": "Oarint"
  },
  "وارنش": {
    "bn": "চাক্চক্য, ঔজ্বল্য, বার্নিশ করা",
    "ro": "Oarnisa"
  },
  "وارننگ": {
    "bn": "সতর্কতা, পরিহার, হুঁশিয়ারি, সাবধানবাণী",
    "ro": "Oarnng"
  },
  "وارے": {
    "bn": "যারা, যেগুলি, যাহারা, তত্, যেগুলিকে",
    "ro": "Oare"
  },
  "واڑا": {
    "bn": "ওয়াদা, প্রতিশ্রুতি, অঙ্গীকার, প্রতিজ্ঞা",
    "ro": "Oara"
  },
  "واڑی": {
    "bn": "ঘেরা জায়গা, ঘের, ওয়াদি, ওয়াদি",
    "ro": "Oari"
  },
  "وازعہ": {
    "bn": "বিতরণ, বিশেষ কোনো যুগে প্রচলিত ধর্ম, ধর্মীয় আচার পালনের দায় থেকে অব্যাহতি",
    "ro": "وازعہ"
  },
  "واژگون": {
    "bn": "বিপরীত, প্রতিবর্তন, বিপরীতমুখী পরিবর্তন, অবস্থার দুর্ভাগ্যজনক পরিবর্তন, বিপর্যয়",
    "ro": "Oazhgon"
  },
  "واژوں": {
    "bn": "বিপথগামী, ন্যায়ভ্রষ্ট, বিকৃত, স্বেচ্চাচারী, উচ্ছৃখল",
    "ro": "Oazhon"
  },
  "واسا": {
    "bn": "ভাসা, সাঁতার কাটা, ভেসে থাকা, সন্তরণ করা",
    "ro": "Oasa"
  },
  "واسط": {
    "bn": "মধ্যবর্তী, ঘটক, মধ্যস্থতাকারী, দালাল",
    "ro": "Vaasit"
  },
  "واسطہ": {
    "bn": "মধ্যস্থতা, মাধ্যম, অসিলা, সম্পর্ক, দালাল",
    "ro": "Vaasita"
  },
  "واسطے": {
    "bn": "পিছন থেকে, পারস্পরিক ক্রিয়া, সম্পর্ক, জন্য, উদ্দেশ্যে",
    "ro": "Oasite"
  },
  "واسع": {
    "bn": "প্রশস্ত, সুবিস্তৃত, উন্মুক্ত, উদার, সুবিশাল",
    "ro": "Vaase"
  },
  "واسف": {
    "bn": "পর্যাপ্ত, যথেষ্ট, প্রচুর, প্রাচুর্যময়",
    "ro": "واسف"
  },
  "واسکٹ": {
    "bn": "ওয়েস্টকোট, হাতাকাটা ছোট কোটি, শেরওয়ানির ওপর পরা পোশাক",
    "ro": "Vaaskit"
  },
  "واسی": {
    "bn": "অধিবাসী, নিবাসী, বাসিন্দা",
    "ro": "Vaasi"
  },
  "واشپ": {
    "bn": "বোলতা, ভিমরুল, হুল ফোটানো উড়ন্ত বিষাক্ত পতঙ্গ",
    "ro": "Oashp"
  },
  "واصلات": {
    "bn": "যোগাযোগ, সম্পর্ক, সংযোগ, সম্বন্ধ",
    "ro": "Oasilat"
  },
  "واضح": {
    "bn": "দৃশ্যমান, স্পষ্ট, প্রত্যক্ষ, প্রতীয়মান, আপাত",
    "ro": "Vaazih"
  },
  "واضع": {
    "bn": "বর্ণনাকারী, বর্ণনাকর্তা, বর্ণনাকারী ব্যক্তি, বর্ণনাকারক",
    "ro": "Oazya"
  },
  "واعد": {
    "bn": "প্রতিশ্রুতিদানকারী, অঙ্গীকারবদ্ধ ব্যক্তি, ওয়াদাকারী",
    "ro": "واعد"
  },
  "واعظ": {
    "bn": "ধর্মোপদেশক, নসিহতকারী, বক্তা, ধর্মপ্রচারক",
    "ro": "Oaiz"
  },
  "واعظا": {
    "bn": "উপদেষ্টা, মনিটর, উপদেশ, ধর্মানুশাসন, ধর্মাপদেশ",
    "ro": "Oaaza"
  },
  "واعظاں": {
    "bn": "উপদেশ, নৈতিক বক্তৃতা, পরামর্শ, শিক্ষা",
    "ro": "Oaazan"
  },
  "واعظہ": {
    "bn": "উপদেশ, পরামর্শ, শিক্ষা, নসিহত",
    "ro": "واعظہ"
  },
  "واعیہ": {
    "bn": "ঘোষণা, বিজ্ঞপ্তি, এলান, প্রচার",
    "ro": "واعیہ"
  },
  "وافر": {
    "bn": "প্রচুর, প্রভূত, পর্যাপ্ত, অফুরন্ত, বহুলাংশে বিদ্যমান",
    "ro": "Oafir"
  },
  "واقع": {
    "bn": "ঘটনা, ঘটন, আপতন, সঙ্ঘটনকাল, নির্বন্ধ",
    "ro": "Vaaqe"
  },
  "واقعات": {
    "bn": "ঘটনাবলী, পরিস্থিতি, স্থান, আর্থিক অবস্থা, ক্ষেত্র",
    "ro": "Vaaqiaat"
  },
  "واقعاتی": {
    "bn": "ঘটনাক্রমিক, ঘটনাভিত্তিক, বাস্তবঘটিত, বৃত্তান্তমূলক",
    "ro": "Oaqaati"
  },
  "واقعہ": {
    "bn": "সংবাদ, সমাচার, সন্দেশ, বার্তা, খবর",
    "ro": "Vaaqi'a"
  },
  "واقعی": {
    "bn": "আসল, বাস্তবিক, বর্তমান, তথ্য সংক্রান্ত, তথ্যভিত্তিক",
    "ro": "Vaaqi'i"
  },
  "واقف": {
    "bn": "পরিচিত, জানা, জ্ঞানী, অবগত, পরিজ্ঞাত",
    "ro": "Vaaqif"
  },
  "واقفیت": {
    "bn": "দক্ষতা, দক্ষ, কলা, কুশলতা, নৈপুণ্য",
    "ro": "Oaqifyat"
  },
  "واکڑا": {
    "bn": "হাঁটা, চলা, পায়চারি করা, বেড়ান, হাঁটিয়া বেড়ান",
    "ro": "Oakra"
  },
  "واگ": {
    "bn": "ওয়াগ, ফক্কড়, কুঁড়ে লোক, নড়ান, নড়া",
    "ro": "Oag"
  },
  "واگذار": {
    "bn": "অ্যাসাইনমেন্ট, নিয়োগ, বরাদ্দকরণ",
    "ro": "Oagzar"
  },
  "واگذشت": {
    "bn": "সংগঠনের, মুক্তি, খালাস, অব্যাহতি, হ্রাস",
    "ro": "Oagzsht"
  },
  "واگزار": {
    "bn": "আচার, চাটনি, সস, সুস্বাদু ব্যঞ্জন",
    "ro": "Oagzar"
  },
  "والا": {
    "bn": "ঊর্ধস্থিত, নির্দিষ্ট উচ্চতাবিশেষ, স্ফীত, উচ্চ, উন্নত",
    "ro": "Vaalaa"
  },
  "والد": {
    "bn": "পিতা, বাবা, পূর্বপুরুষ, স্রষ্টা, প্রভু",
    "ro": "Vaalid"
  },
  "والدہ": {
    "bn": "মাতা, মা, আম্মা, জননী, গর্ভধারিণী",
    "ro": "Vaalida"
  },
  "والدین": {
    "bn": "পিতামাতা, পিতা মাতা, মা বাবা, জনক জননী, অভিভাবকদ্বয়",
    "ro": "Vaalidain"
  },
  "واللہ": {
    "bn": "প্রভু, পরমাত্মা",
    "ro": "Oalla"
  },
  "والو": {
    "bn": "গতিনিয়ন্ত্রক কল, বিদ্যুতের যন্ত্রবিশেষ, কপাটক, বেতারের যন্ত্রবিশেষ, ভালভ",
    "ro": "Oalo"
  },
  "والہ": {
    "bn": "ওয়াল্লা, লোক, লোক, ব্যক্তি",
    "ro": "Oala"
  },
  "والے": {
    "bn": "যারা, যেগুলি, যাহারা, তত্, যেগুলিকে",
    "ro": "Oale"
  },
  "وام": {
    "bn": "ঋণ, ধার, কর্জ, দেনা, দাদন",
    "ro": "Oam"
  },
  "واماندگی": {
    "bn": "অলসতা, জড়তা, কুঁড়েমি, নিস্তেজ ভাব",
    "ro": "Oamandgi"
  },
  "وامدار": {
