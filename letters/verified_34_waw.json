    "bn": "অনৈতিকতা, ব্যভিচার, কদভ্যাস, অধার্মিকতা",
    "ro": "Osmt"
  },
  "وصول": {
    "bn": "আগমন, আগম, পৌঁছান, উপনীতি, পৌঁছ",
    "ro": "Ousol"
  },
  "وصولی": {
    "bn": "পুনরুদ্ধার, পুনরুদ্ধারকরণ, ফিরিয়ে পাওয়া, উদ্ধার",
    "ro": "Ousoli"
  },
  "وصی": {
    "bn": "উইলকারী, উইলকর্তা, উইলকারী ব্যক্তি, উইলকারক",
    "ro": "Oassi"
  },
  "وصیت": {
    "bn": "অসিয়ত, উইল, অন্তিম উপদেশ, নির্দেশনা",
