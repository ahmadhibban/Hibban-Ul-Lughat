{
  "عابد": {
    "bn": "প্রতীক্ষা করা, সম্মুখীন হওয়া, উপাসক, ইবাদতকারী, পরম ভক্ত",
    "ro": "'aabid"
  },
  "عابدہ": {
    "bn": "পরম ইবাদতকারিনী নারী, পুণ্যবতী রমণী",
    "ro": "'aabida"
  },
  "عابدیت": {
    "bn": "উপাসক ত্ব, উপাসক তা, উপাসক ভাব, উপাসকময় অবস্থা",
    "ro": "Aabidiit"
  },
  "عابر": {
    "bn": "ক্ষণস্থায়ী, নশ্বর, অনিত্য, মরণশীল",
    "ro": "Aabir"
  },
  "عابرہ": {
    "bn": "ক্ষণস্থায়ী, নশ্বর, অনিত্য, মরণশীল",
    "ro": "عابرہ"
  },
  "عابس": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "عابس"
  },
  "عاتق": {
    "bn": "সম্মান, মর্যাদা, গৌরব, ইজ্জত",
    "ro": "Aatiq"
  },
  "عاتقہ": {
    "bn": "অঙ্গীকার, প্রতিজ্ঞা, শপথ, প্রতিশ্রুতি",
    "ro": "عاتقہ"
  },
  "عاتک": {
    "bn": "শপথ, প্রতিজ্ঞা, অঙ্গীকার, কসম",
    "ro": "عاتک"
  },
  "عاثم": {
    "bn": "সীমাহীন, অন্তহীন, অনন্ত",
    "ro": "عاثم"
  },
  "عاج": {
    "bn": "আইভরি, হাতি, জলহস্তী, গজদন্ত",
    "ro": "Aaj"
  },
  "عاجز": {
    "bn": "নম্র, প্রতু্যত্পন্ন, লগবগে",
    "ro": "Aajiz"
  },
  "عاجزانہ": {
    "bn": "নম্রতা, বিনয়, ভদ্রতা, শালীনতা, খুশু খুজু",
    "ro": "Aajizanah"
  },
  "عاجزہ": {
    "bn": "নম্রতা, বিনয়, ভদ্রতা, শালীনতা, খুশু খুজু",
    "ro": "Aajizah"
  },
  "عاجزی": {
    "bn": "অক্ষমতা, অসামথ্র্য, অকৃতিত্ব, আইনগত অনধিকার, আইনগত অযোগ্যতা",
    "ro": "'aajizi"
  },
  "عاجل": {
    "bn": "ত্বরিত, দ্রুতগামী, নগদ, আশু",
    "ro": "Aajil"
  },
  "عاجلانہ": {
    "bn": "জরুরী, অলঙ্ঘনীয়, অত্যাবশ্যক",
    "ro": "Aajilanah"
  },
  "عاجلہ": {
    "bn": "জরুরী, অলঙ্ঘনীয়, অত্যাবশ্যক",
    "ro": "Aajilah"
  },
  "عاد": {
    "bn": "গুণনীয়ক, উত্পাদক, গুণক, যে ঘটনা, পরিস্থিতি প্রভৃতি কোনো ফল বা পরিণতির কারণ",
    "ro": "Aad"
  },
  "عادات": {
    "bn": "অভ্যাস, স্বভাব, অনুশীলন, চর্চা",
    "ro": "Aadat"
  },
  "عادت": {
    "bn": "প্রচলিত সামাজিক রীতিনীতি, বহুদিনের অভ্যাস, প্রথা, অভ্যাস, স্বভাব",
    "ro": "Aadat"
  },
  "عادتاً": {
    "bn": "অভ্যাসগতভাবে, অভ্যাসগত ভাবেই",
    "ro": "Aadtaan"
  },
  "عادلانہ": {
    "bn": "সমর্থন বা অনুমোদন করা, মঞ্জুর করা, ভেবেচিন্তে প্রশংসা করা, অনুমোদন, উপযুক্ত কর্ত্বপক্ষের অনুমোদন",
    "ro": "Aadilanah"
  },
  "عادہ": {
    "bn": "আসক্তি, হৃদ্যতা, অনুরাগ, টান",
    "ro": "Aadah"
  },
  "عادی": {
    "bn": "অভ্যস্ত, সাধারণ, স্বাভাবিক, প্রাত্যহিক",
    "ro": "'aadi"
  },
  "عادةً": {
    "bn": "সাধারণত, স্বাভাবিকভাবে, স্বভাবত, অধিকাংশ ক্ষেত্রে",
    "ro": "Aad"
  },
  "عار": {
    "bn": "সহজবশ্য, অনুগত, নিরীহ, এবং, অধিকন্তু",
    "ro": "Aar"
  },
  "عاربہ": {
    "bn": "রথ, প্রাচীন যুদ্ধযান, উৎসবের সজ্জিত বাহন",
    "ro": "Aaribah"
  },
  "عارض": {
    "bn": "ব্যাধি, রোগ, পীড়া, অসুখ",
    "ro": "Aariz"
  },
  "عارضہ": {
    "bn": "ব্যাধি, রোগ, পীড়া, অসুখ",
    "ro": "Aarzah"
  },
  "عارضی": {
    "bn": "অস্পষ্টভাবে বলা, অস্ফুট স্বরে বলা, অস্থায়ী, ক্ষণস্থায়ী, সাময়িক",
    "ro": "Aarizi"
  },
  "عارنت": {
    "bn": "লজ্জা, অপমান, অমর্যদা, সংকোচ",
    "ro": "Aarnt"
  },
  "عاری": {
    "bn": "বঞ্চিত, মুক্ত, খালি, শূন্য",
    "ro": "'aari"
  },
  "عاریت": {
    "bn": "ধার করা, গ্রহণ, পাকড়াও, আহরণ",
    "ro": "Aarit"
  },
  "عاریتی": {
    "bn": "ধার করা, গ্রহণ, পাকড়াও, আহরণ",
    "ro": "Aariti"
  },
  "عازم": {
    "bn": "প্রতিশ্রুতিবদ্ধ, প্রতিজ্ঞাবদ্ধ, কৃত, সমর্পিত, ভারার্পণ করা",
    "ro": "Aazim"
  },
  "عاسل": {
    "bn": "মহৎ, অভিজাত, উচ্চবংশজাত, উন্নতচরিত্র, আদর্শবান",
    "ro": "عاسل"
  },
  "عاشر": {
    "bn": "ছাই, ভস্ম, মাটি, ধূলি",
    "ro": "Aashir"
  },
  "عاشرت": {
    "bn": "সম্পদ, ধন, খুব বেশী সংখ্যা বা পরিমাণ, ধনসম্পদ",
    "ro": "Aashrt"
  },
  "عاشق": {
    "bn": "প্রেমিক, প্রেমিকা, প্রণয়ী, প্রিয়, দয়িত",
    "ro": "'aashiq"
  },
  "عاشقان": {
    "bn": "আশেকসমূহ, আশেকমণ্ডলী, আশেকবৃন্দ, সকল আশেক",
    "ro": "Aashqan"
  },
  "عاشقانہ": {
    "bn": "প্রেম, ভালোবাসা, প্রীতি, স্নেহ",
    "ro": "Aashiqanah"
  },
  "عاشقوں": {
    "bn": "প্রেমিক, মুগ্ধ, আসক্ত, পাগলপারা",
    "ro": "Aashqon"
  },
  "عاصر": {
    "bn": "সমসাময়িক, যুগপৎ, বর্তমান সময়ের",
    "ro": "Aasir"
  },
  "عاصم": {
    "bn": "সীমাহীন, অনন্ত, অন্তহীন",
    "ro": "Aasim"
  },
  "عاصی": {
    "bn": "কাছে আসা, ঘনিয়ে আসা, নিকটবর্তী হওয়া, সমকক্ষ হওয়া, কাছাকাছি আসা",
    "ro": "'aasi"
  },
  "عاطر": {
    "bn": "সুগন্ধি, সুবাস, খোশবু",
    "ro": "Aatir"
  },
  "عاطفت": {
    "bn": "স্নেহ, প্রীতি, ভালোবাসা, প্রেম",
    "ro": "Aatifat"
  },
  "عاطفہ": {
    "bn": "স্নেহ, প্রীতি, ভালোবাসা, প্রেম",
    "ro": "Aatifah"
  },
  "عاطفیت": {
    "bn": "আবেগপ্রবণতা, ভঙ্গুরতা, স্নেহপূর্ণতা",
    "ro": "Aatifit"
  },
  "عاطل": {
    "bn": "বেকার, অকেজো, অপদার্থ, অকর্মা",
    "ro": "Aatil"
  },
  "عاطم": {
    "bn": "পরমাণু, একটুমাত্র, কণা, ধূলিকণা",
    "ro": "عاطم"
  },
  "عافی": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "Aafi"
  },
  "عافیت": {
    "bn": "সুস্থতা, কুশল, স্বাস্থ্য, আরোগ্য",
    "ro": "Aafyat"
  },
  "عاق": {
    "bn": "প্রচলিত অর্থ, ব্যবহারিক অর্থ",
    "ro": "Aaq"
  },
  "عاقبت": {
    "bn": "পরিণতি, ফলাফল, পরিণাম, শেষ ফল",
    "ro": "Aaqibat"
  },
  "عاقل": {
    "bn": "জ্ঞানী, বিদ্যা, ইলম, প্রজ্ঞা, বোধ",
    "ro": "Aaqil"
  },
  "عاقلانہ": {
    "bn": "বিজ্ঞ, প্রবীণ, বিচক্ষণ, জ্ঞানী, জ্ঞানপূর্ণ",
    "ro": "Aaqilanah"
  },
  "عاقلی": {
    "bn": "প্রজ্ঞা, জ্ঞান, বুদ্ধি, বুদ্ধিমত্তা",
    "ro": "Aaqili"
  },
  "عاکس": {
    "bn": "প্রতিফলন, প্রতিবিম্ব, ছবি, বিপরীত",
    "ro": "Aakis"
  },
  "عاکسہ": {
    "bn": "আনয়ন, প্রস্তাবনা, প্রবৃত্ত করান",
    "ro": "Aakisah"
  },
  "عالم": {
    "bn": "বিদ্বান্, শিষ্য, ভট্ট, শিক্ষিত ব্যক্তি, ছাত্রবৃত্তিভোগী ব্যক্তি",
    "ro": "'aalam"
  },
  "عالمانہ": {
    "bn": "পাণ্ডিত্যপূর্ণ, ওস্তাদসুলভ, শিক্ষকসুলভ, নৈপুণ্যপূর্ণ",
    "ro": "Aalimanah"
  },
  "عالمگیر": {
    "bn": "তোপ, কেষ্টবিষ্টু, হোমরাচোমরা, তোপ, বিশ্বব্যাপী",
    "ro": "Aalmgir"
  },
  "عالمگیریت": {
    "bn": "বিশ্বায়ন, গ্লোবালাইজেশন, বিশ্বব্যাপী অর্থনৈতিক ও সাংস্কৃতিক সংহতি, গ্লোবাল ধারণা",
    "ro": "Aalamgiriit"
  },
  "عالمہ": {
    "bn": "বিদ্বান্, শিষ্য, ভট্ট, শিক্ষিত ব্যক্তি, ছাত্রবৃত্তিভোগী ব্যক্তি",
    "ro": "Aalimah"
  },
  "عالمی": {
    "bn": "বিশ্বব্যাপী, আন্তর্জাতিক, সর্বজনীন, আন্তঃরাষ্ট্রীয়",
    "ro": "Aalami"
  },
  "عالی": {
    "bn": "উচ্চ, মহান, উন্নত, মহিমান্বিত",
    "ro": "'aali"
  },
  "عالیہ": {
    "bn": "আলিয়া, উচ্চ মর্যাদাসম্পন্না, মহীয়সী, আলিয়া মাদ্রাসা",
    "ro": "'aaliya"
  },
  "عام": {
    "bn": "সমস্ত, সকল, সম্পূর্ণ, সব, সাধারণ",
    "ro": "'aam"
  },
  "عامتًا": {
    "bn": "সাধারণভাবে, অধিকাংশে, মোটের ওপর, প্রথাগতভাবে",
    "ro": "Aamtana"
  },
  "عامل": {
    "bn": "ফ্যাক্টর, গুণনীয়ক, উত্পাদক, গুণক, যে ঘটনা",
    "ro": "Aamil"
  },
  "عاملانہ": {
    "bn": "কর্ম, কাজ, দায়িত্ব, ক্রিয়া",
    "ro": "Aamilanah"
  },
  "عاملہ": {
    "bn": "কার্যনির্বাহী পরিষদ, পরিচালনা কমিটি, কার্যনির্বাহী কর্মীবৃন্দ, পরিচালন পর্ষদ",
    "ro": "Aamila"
  },
  "عاملی": {
    "bn": "ফ্যাক্টর, কারণের, গুণনীয়ক, উত্পাদক",
    "ro": "Aamili"
  },
  "عاملیت": {
    "bn": "সংস্থা, সংগঠন, সুব্যবস্থা, শৃঙ্খলা",
    "ro": "Aamilit"
  },
  "عامہ": {
    "bn": "পাবলিক, সর্বজনীন, প্রকাশ্য, সম্প্রদায়ের, সর্বসাধারণের বিদিত",
    "ro": "Aamma"
  },
  "عامی": {
    "bn": "সাধারণ, প্রচলিত, মামুলি, সার্বজনীন",
    "ro": "Aami"
  },
  "عامیان": {
    "bn": "সাধারণ লোকসকল, সাধারণ জনতা",
    "ro": "Aamyan"
  },
  "عامیانہ": {
    "bn": "সাধারণ, প্রচলিত, মামুলি, সার্বজনীন",
    "ro": "Aamyanah"
  },
  "عامیت": {
    "bn": "সাধারণ ত্ব, সাধারণ তা, সাধারণ ভাব, সাধারণময় অবস্থা",
    "ro": "Aamiit"
  },
  "عاید": {
    "bn": "আয়, আগমন, উপার্জন, প্রবেশ",
    "ro": "Aaid"
  },
  "عایق": {
    "bn": "নিরোধক, কনডম, জন্মনিয়ন্ত্রণের রাবার আবরণী",
    "ro": "Aaiq"
  },
  "عائد": {
    "bn": "মদ্যপ, নেশায় বুঁদ, আসবপ্রমত্ত, মাতাল, আজ",
    "ro": "Aaidi"
  },
  "عائدہ": {
    "bn": "আয়, মুনাফা, রাজস্ব, লভ্যাংশ",
    "ro": "Aaida"
  },
  "عائشہ": {
    "bn": "আয়েশা, সমৃদ্ধিময়ী, দীর্ঘজীবী, উম্মুল মুমিনিন",
    "ro": "عائشہ"
  },
  "عائق": {
    "bn": "প্রতিবন্ধকতা, বাধা, বিঘ্ন, সংঘাত",
    "ro": "Aaiq"
  },
  "عائل": {
    "bn": "তেল, তৈল, স্নেহপদার্থ, রান্নার ভোজ্যতেল",
    "ro": "Aail"
  },
  "عائلہ": {
    "bn": "পরিবার, বংশ, পরিবারবর্গ, আত্মীয়স্বজন, আহলিয়া",
    "ro": "'aaila"
  },
  "عائلی": {
    "bn": "পারিবারিক, দাম্পত্য, পরিবারসংক্রান্ত, গার্হস্থ্য",
    "ro": "'aaili"
  },
  "عبا": {
    "bn": "মদ্যপানোৎসব, পানোত্সব সম্মেলন, আলখাল্লা, জোব্বা, আস্তরণ",
    "ro": "Aba"
  },
  "عبادت": {
