  },
  "علفا": {
    "bn": "আলফালফা, পশুখাদ্যরূপে ব্যবহৃত ত্রিপত্রবিশিষ্ট উদ্ভিদবিশেষ, ত্রিপত্রোত্পাদী বৃক্ষবিশেষ",
    "ro": "Alfa"
  },
  "علفگاہ": {
    "bn": "কাঠের বা বাঁশের বাঁশি, বাঁশি বাজানো, বাঁশি, নল ব নলাকার অংশ, শ্বাসনলী",
    "ro": "Alfgah"
  },
  "علفہ": {
    "bn": "ঘাস, পশুখাদ্য, খড়, ভুসি",
    "ro": "علفہ"
  },
  "علق": {
    "bn": "ভাষ্য, ব্যাখ্যাগ্রন্থ, টীকা",
    "ro": "Alaq"
  },
  "علم": {
    "bn": "জ্ঞান, বিদ্যা, শিক্ষা, পাণ্ডিত্য, বোধ",
    "ro": "'ilm"
  },
  "علما": {
    "bn": "উপগত, বিশেষজ্ঞ, পাণ্ডিত্যপূর্ণ শিক্ষিত, উপলব্ধ, কৃত",
    "ro": "Ulamaa"
  },
  "علمدار": {
    "bn": "জ্ঞানী, আলেম, বিদ্বান ব্যক্তি",
    "ro": "Almdar"
  },
  "علموں": {
    "bn": "জ্ঞান, বিদ্যা, প্রজ্ঞা, বোধ",
    "ro": "Almon"
  },
  "علمی": {
    "bn": "বৈজ্ঞানিক, বিজ্ঞানসম্মত, বিজ্ঞানসংক্রান্ত, সাহিত্য বা সাহিত্যিক সংক্রান্ত, সাহিত্যানুগ",
    "ro": "'ilmi"
  },
  "علمیت": {
    "bn": "শিক্ষা, পাণ্ডিত্য, বিদ্যা, শিক্ষণীয় বিষয়, বু্যত্পত্তি",
    "ro": "Ilmyat"
  },
  "علمیہ": {
    "bn": "জ্ঞান, বিদ্যা, প্রজ্ঞা, বোধ",
    "ro": "Almih"
  },
  "علن": {
    "bn": "সুস্পষ্ট, প্রত্যক্ষ, স্পষ্ট, বেপরোয়া, প্রকট",
    "ro": "Alan"
  },
  "علو": {
    "bn": "বরই, উত্তম বস্তু",
    "ro": "Ulo"
  },
  "علوفہ": {
    "bn": "পশুখাদ্য, ঘাস, খড়, ভুসি",
    "ro": "Alofa"
  },
  "علوم": {
    "bn": "জ্ঞানসমূহ, বিদ্যাসমূহ, বিজ্ঞানাবলী, ধর্মীয় ও জাগতিক শাখাসমূহ",
    "ro": "'ulum"
  },
  "علی": {
    "bn": "হযরত আলী, উপরে, উচ্চ, মহিমান্বিত",
    "ro": "'ali"
  },
  "علیا": {
    "bn": "আলিয়া, উচ্চ মর্যাদাসম্পন্না, মহীয়সী, আলিয়া মাদ্রাসা",
    "ro": "علیا"
  },
  "علیحدگی": {
    "bn": "বিচ্ছিন্নতা, বিচ্ছেদ, পদত্যাগ, পৃথকীকরণ",
    "ro": "'alaihdagi"
  },
  "علیحدہ": {
    "bn": "দূরে, তফাতে, ব্যবধানে, একদিকে, একপাশে",
    "ro": "'alaihida"
  },
  "علیقہ": {
    "bn": "ক্ষেত্র, ক্ষেত্রফল, ক্ষেত্রের আয়তন, অঁচল",
    "ro": "Aliqa"
  },
  "علیگ": {
    "bn": "আলাদা, পৃথক, বিচ্ছিন্ন, ভিন্ন",
    "ro": "Alig"
  },
  "علیون": {
    "bn": "এগারো, সংখ্যা, একাদশ, দশ ও একের সমষ্টি",
    "ro": "Alyon"
  },
  "علیہا": {
    "bn": "হে প্রভু, হে পালনকর্তা, করুণাময় রব",
    "ro": "Aliha"
  },
  "علٰی": {
    "bn": "গৌরব, গরিমা, মহিমা, প্রসিদ্ধি, উচ্চ সম্মান",
    "ro": "Alaai"
  },
  "عمادات": {
    "bn": "বিশিষ্টতা, সহত্ত্ব, বিশেষত্ব, স্বাতন্ত্র্য",
    "ro": "Amadat"
  },
  "عمار": {
    "bn": "হযরত আম্মার বিন ইয়াসির রাদিআল্লাহু আনহু, ইসলামের প্রথম যুগের প্রখ্যাত সাহাবি ও শহীদ",
    "ro": "'ammaar"
  },
  "عمارات": {
    "bn": "ভবন, গৃহ, প্রাসাদ, সদন",
    "ro": "Amarat"
  },
  "عمارت": {
    "bn": "ভবন, দালান, সৌধ, প্রাসাদ",
    "ro": "'imaarat"
  },
  "عمارتی": {
    "bn": "নির্মাণ, গঠন, সৃষ্টি, রচনা",
    "ro": "Imarati"
  },
  "عمارہ": {
    "bn": "সমৃদ্ধিশীল নারী, পূর্ণাঙ্গ চরিত্রবতী, স্ত্রীবাচক নাম",
    "ro": "'ammaara"
  },
  "عماری": {
    "bn": "হাওদা, হাতির পিঠের ওপর ঢাকা দেওয়া সুরক্ষিত বসার আসন",
    "ro": "Amari"
  },
  "عمال": {
    "bn": "শ্রমিক, দিনমজুর, মজুর, কুলি",
    "ro": "Ummal"
  },
  "عمامہ": {
    "bn": "পাগড়ি, উষ্ণীষ, শিরস্ত্রাণ, সম্মানসূচক শিরোভূষণ",
    "ro": "Ammamah"
  },
  "عمان": {
    "bn": "পারস্য উপসাগরীয় ঐতিহাসিক মুসলিম সালতানাত, মাসকাট রাজধানীর দেশ",
    "ro": "'umaan"
  },
  "عمائدین": {
    "bn": "বিশিষ্ট ব্যক্তিবর্গ, গণ্যমান্য ব্যক্তিবৃন্দ, সমাজপতিগণ",
    "ro": "Amaidin"
  },
  "عمد": {
    "bn": "ইচ্ছাকৃত, সংকল্পমূলক, ঐচ্ছিক, স্বতঃপ্রণোদিত",
    "ro": "Amad"
  },
  "عمداً": {
    "bn": "ইচ্ছাকৃতভাবে, জ্ঞাতসারে, ইচ্ছাপূর্বক, ভেবেচিন্তে",
    "ro": "Amdaan"
  },
  "عمدت": {
    "bn": "শ্রেষ্ঠত্ব, চরম উৎকর্ষ, চরম গুণ, মহত্ত্ব",
    "ro": "Amdt"
  },
  "عمدگی": {
    "bn": "সূক্ষ্মতা, সুন্দরতা, অণিমা, যথাযথত্ব, মনোহারিত্ব",
    "ro": "Umdagi"
  },
  "عمدہ": {
    "bn": "শ্রেণী, বিভাগ, বর্গ, সামাজিক শ্রেণীবিভাগ, পরীক্ষার ফলভিত্তিক বিভাগ",
    "ro": "'umda"
  },
  "عمدًا": {
    "bn": "উদ্দেশ্যে, উদ্দেশ্যমূলকভাবে, ইচ্ছাকৃতভাবে, জ্ঞাতসারে, ইচ্ছাপূর্বক",
    "ro": "Amdana"
  },
  "عمر": {
    "bn": "বয়স, আয়ু, জীবনকাল, হায়াত, জীবনসীমা",
    "ro": "Umr"
  },
  "عمران": {
    "bn": "কুরআনে বর্ণিত পুণ্যবান ব্যক্তিত্ব আলে ইমরান, সমৃদ্ধি, জনবসতি",
    "ro": "'imraan"
  },
  "عمرانیات": {
    "bn": "সমাজবিজ্ঞান, সামাজিক বিজ্ঞান, সামাজিক রীতিনীতি ও মানব সম্পর্কের শাস্ত্র",
    "ro": "Amranyat"
  },
  "عمرگریزاں": {
    "bn": "বয়সহীন, বয়সবিহীন, বয়সশূন্য, বয়সবর্জিত",
    "ro": "Umrigurizan"
  },
  "عمرہ": {
    "bn": "কাবা শরিফ জিয়ারতের বরকতময় সংক্ষিপ্ত হজ, ইহরাম তাওয়াফ সাঈর পুণ্য ইবাদত",
    "ro": "Umraa"
  },
  "عمری": {
    "bn": "বয়স, আয়ু, জীবনকাল, হায়াত",
    "ro": "Amri"
  },
  "عمریں": {
    "bn": "বয়স, আয়ু, জীবনকাল, হায়াত",
    "ro": "Amrin"
  },
  "عمرے": {
    "bn": "বয়স, আয়ু, জীবনকাল, হায়াত",
    "ro": "Amre"
  },
  "عمق": {
    "bn": "গভীরতা, তলদেশ, স্তর, ভাঁজ",
    "ro": "Amq"
  },
  "عمل": {
    "bn": "কর্ম, ক্রিয়া, কাজ, কর্মানুষ্ঠান, নাটকের অঙ্গ",
    "ro": "'amal"
  },
  "عملاً": {
    "bn": "ব্যবহারিকভাবে, কার্যকরীভাবে, কার্যত, প্রকৃতপক্ষে",
    "ro": "Amlaan"
  },
  "عملدار": {
    "bn": "অল্পবয়স্ক, নবীন, নতুন, তরূণ, কচি",
    "ro": "Amldar"
  },
  "عملدرآمد": {
    "bn": "মৃত্যুদন্ড, ইন্তেকাল, মরণ, পরলোকগমন",
    "ro": "Amldraamd"
  },
  "عملہ": {
    "bn": "কর্মকর্তা কর্মচারীবৃন্দ, স্টাফ, কর্মীবাহিনী, প্রাতিষ্ঠানিক সেবকদল",
    "ro": "'amala"
  },
  "عملی": {
    "bn": "দুর্বল, অশক্ত, ক্ষীণবুদ্ধি, নিস্তেজ, ক্ষীণ",
    "ro": "Amali"
  },
  "عملیات": {
    "bn": "অপারেশন, প্রক্রিয়া, কার্যপদ্ধতি, পরিচালনা",
    "ro": "Amalyat"
  },
  "عملیت": {
    "bn": "অনুশীলন, চর্চা, মশক, অভ্যাস",
    "ro": "Amalyat"
  },
  "عمود": {
    "bn": "ঋজু, খাড়া, উল্লম্ব, লম্ব, সমকোণে স্থাপিত",
    "ro": "Umod"
  },
  "عموداً": {
    "bn": "উল্লম্বভাবে, ঊর্ধ্বাধভাবে",
    "ro": "Amodaan"
  },
  "عمودی": {
    "bn": "উলম্ব, খাড়া, লম্বমান, উল্লম্বিক, ভূমি থেকে খাড়াভাবে উত্থিত",
    "ro": "Amodi"
  },
  "عمودًا": {
    "bn": "স্পষ্টবাদী, পুরোদস্তুর, নিতান্ত, উল্লম্বভাবে, ঊর্ধ্বাধভাবে",
    "ro": "Amodana"
  },
  "عموم": {
    "bn": "সাধারণত, সাধারণভাবে, সচরাচর, অধিকাংশ স্থলে, প্রচলিতভাবে",
    "ro": "Umom"
  },
  "عموماً": {
    "bn": "সাধারণত, সাধারণভাবে, সচরাচর, অধিকাংশ স্থলে, প্রচলিতভাবে",
    "ro": "Amomaan"
  },
  "عمومی": {
    "bn": "সাধারণ, প্রমাণ, নিয়মাফিক, নিয়মাফিক নমুনা, নিয়মাফিক বস্তু",
    "ro": "'umumi"
  },
  "عمومیت": {
    "bn": "সাধারণতা, সাধারণত্ব, নির্বিশেষত্ব, বৈশিষ্ট্যহীনতা, সামান্যতা",
    "ro": "Umomiit"
  },
  "عمومًا": {
    "bn": "সাধারণত, সাধারণভাবে, সচরাচর, অধিকাংশ স্থলে, প্রচলিতভাবে",
    "ro": "Amomana"
  },
  "عموی": {
    "bn": "প্রাচীর, উন্নত বপ্র, চাচা, আঙ্কেল, মেসো",
    "ro": "Amoi"
  },
  "عمی": {
    "bn": "চাচা, আঙ্কেল, মেসো",
    "ro": "Amaai"
  },
  "عمیا": {
    "bn": "অন্ধত্ব, দৃষ্টিহীনতা, অবিবেচনা, মোহগ্রস্ততা",
    "ro": "Amya"
  },
  "عمید": {
    "bn": "উচ্চপদস্থ ব্যক্তি, সম্ভ্রান্ত ব্যক্তি, আশা, ভরসা, প্রত্যাশা",
    "ro": "Amid"
  },
  "عمیر": {
    "bn": "বয়স, আয়ু, জীবনকাল, হায়াত",
    "ro": "عمیر"
  },
  "عمیق": {
    "bn": "তীব্র, গাঢ়, প্রচণ্ড, প্রগাঢ়, দারূণ",
    "ro": "Amiq"
  },
  "عمیل": {
    "bn": "প্রতিনিধি, এজেন্ট, গ্রাহক, কার্যকর্তা",
    "ro": "Amil"
  },
  "عمیم": {
    "bn": "বিস্তৃত, ব্যাপক, সর্বাঙ্গীণ, প্রভূত বোধশক্তিসম্পন্ন, সাধারণ",
    "ro": "Amim"
  },
  "عمٰی": {
    "bn": "চাচা, কাকা, জেঠা, পিসা",
    "ro": "Amaai"
  },
  "عن": {
    "bn": "থেকে, হতে, হইতে, কারণ, উদ্দেশ্য",
    "ro": "An"
  },
  "عناب": {
    "bn": "জাম্বুরা, মোসম্বিলেবু, শরবতী লেবু",
    "ro": "Anab"
  },
  "عنابی": {
    "bn": "খয়েরি, লালচে খয়েরি, মেহগনি রঙা, গাঢ় লাল",
    "ro": "Unnaabi"
  },
  "عناد": {
    "bn": "ঘৃণা, বিরোগ, শত্রুতা, প্রতিকূলতা, প্রতিকূলাচরণ",
    "ro": "Inad"
  },
  "عناصر": {
    "bn": "প্রকৃতির শক্তি, আবহাত্তয়া, শাস্ত্রের প্রাথমিক তত্ত্ব, উপাদান, অঙ্গ",
    "ro": "Anasir"
  },
  "عنایات": {
    "bn": "অনুগ্রহসমূহ, দানসমূহ, কৃপারাশি, মেহেরবানিমালা",
    "ro": "'inaayaat"
  },
  "عنایت": {
    "bn": "অনুগ্রহ, কৃপা, দান, বদান্যতা, দয়া",
    "ro": "'inaayat"
  },
  "عنبر": {
