  },
  "عربی": {
    "bn": "নিঃশর্ত, অনাপেক্ষিক, প্রত্যক্ষ, অত্যাচারী, পরপীড়ক",
    "ro": "'arbi"
  },
  "عربیہ": {
    "bn": "সাধারণ, প্রমাণ, নিয়মাফিক, নিয়মাফিক নমুনা, নিয়মাফিক বস্তু",
    "ro": "Arabiha"
  },
  "عرش": {
    "bn": "সিংহাসন, রাজপদ, রাজাসন, রাজসিংহাসন, গদি",
    "ro": "Arsh"
  },
  "عرشی": {
    "bn": "সমালোচনামূলক, সমালোচনা সম্বন্ধীয়, স্বর্গীয়, আরশ সংক্রান্ত, আকাশবাসী",
    "ro": "Arshi"
  },
  "عرشیاں": {
    "bn": "সিংহাসন, তখত, রাজসিংহাসন, মসনদ",
    "ro": "Arshyan"
  },
  "عرصہ": {
    "bn": "স্পষ্ট, সহজবোধ্য, জটিলতাহীন, ডাহা, সাধারণ",
    "ro": "Arsah"
  },
  "عرصے": {
    "bn": "সময়কাল, কাল, দিনসমূহ, দিবসসমূহ",
    "ro": "Arse"
  },
  "عرض": {
    "bn": "অক্ষাংশ, এলাকা, প্রসার, ব্যাপ্তি, মহাবিস্তার",
    "ro": "'arz"
  },
  "عرضاً": {
    "bn": "আড়াআড়িভাবে, ঘটনাক্রমে, কটুগন্ধ ছড়ানো, পূতিগন্ধ নিঃসৃত হওয়া, অপ্রীতিভাজন",
    "ro": "Arzaan"
  },
  "عرضہ": {
    "bn": "সরবরাহ, রসদ, জোগান, খাদ্যসম্ভার",
    "ro": "Arza"
  },
  "عرضی": {
    "bn": "দেওয়ানি মামলা, দেওয়ানি মামলা, দাখিল, নমন, নতি",
    "ro": "'arzi"
  },
  "عرعر": {
    "bn": "জুনিপার, একধরণের গাছ",
    "ro": "Arar"
  },
  "عرف": {
    "bn": "অন্য নাম, আর এক নাম, ছদ্মনাম, উপনাম",
    "ro": "'urf"
  },
  "عرفاً": {
    "bn": "উপনাম, অন্য নাম, আর এক নাম, ছদ্মনাম",
    "ro": "Arfaan"
  },
  "عرفی": {
    "bn": "ডাকনাম, প্রচলিত নাম, লোকমুখে পরিচিত নাম",
    "ro": "Urfi"
  },
  "عرفیت": {
    "bn": "ডাকনাম, প্রচলিত নাম, লোকমুখে পরিচিত নাম",
    "ro": "Urfyat"
  },
  "عرق": {
    "bn": "শিরা, নাল, রক্তবাহ, শোণিতশিরা, হৃত্পিণ্ডে রক্তবাহী শিরা",
    "ro": "'araq"
  },
  "عرقی": {
    "bn": "জাতিগত, রাষ্ট্রীয়, জনসাধারণযুক্ত",
    "ro": "Araqi"
  },
  "عرم": {
    "bn": "শান্তি, স্বস্তি, বিশ্রাম",
    "ro": "Arim"
  },
  "عروبہ": {
    "bn": "ক্যারিবীয় সাগরের মনোরম দ্বীপ ও স্বায়ত্তশাসিত ডাচ রাষ্ট্র, পর্যটন দ্বীপ, ক্রান্তীয় দ্বীপভূমি",
    "ro": "Aroba"
  },
  "عروت": {
    "bn": "যৌনতা, সেক্স, নর নারীর দৈহিক সম্পর্ক, প্রজনন জৈবিক ক্রিয়া",
    "ro": "Arot"
  },
  "عروج": {
    "bn": "উত্থান, উন্নতি, শীর্ষবিন্দু, সমৃদ্ধি, পরম উৎকর্ষ",
    "ro": "'uruj"
  },
  "عروس": {
    "bn": "তীরন্দাজ, ধনুর্ধর, ধানুকী, ধনুকধারী, নববধূ",
    "ro": "Aros"
  },
  "عروسی": {
    "bn": "বিবাহ, বিয়ে, নিকাহ, শাদি, পরিণয়",
    "ro": "Arosi"
  },
  "عروض": {
    "bn": "উপনিবেশ স্থাপন করা, বসতি স্থাপন করা, প্রস্তাবনা, ভূমিকা, মুখবন্ধ",
    "ro": "Aroz"
  },
  "عروضی": {
    "bn": "উপস্থাপনা, প্রদত্ত বস্তু, উপহার, বর্ণনা",
    "ro": "Arozi"
  },
  "عروق": {
    "bn": "জঙ্গী বিমান, সৈন্য, যুদ্ধে নিযুক্ত ব্যক্তি, যোদ্ধা, ভাস্কুলার",
    "ro": "Uroq"
  },
  "عروقی": {
    "bn": "ভাস্কুলার, সংবহনতান্ত্রিক, রক্তনালী, শিরা",
    "ro": "Uroqi"
  },
  "عرومہ": {
    "bn": "সুবাস, বিশেষ ধরনের সৌরভ, পরিমল, সুগন্ধ, মধুগন্ধ",
    "ro": "عرومہ"
  },
  "عریانی": {
    "bn": "অশ্লীলতা, অপবিত্রতা, নগ্নতা, আদিমতা, অব্যক্ত",
    "ro": "Uryani"
  },
  "عریاں": {
    "bn": "নগ্নতা, আদিমতা, অব্যক্ত, আত্মা",
    "ro": "Uryan"
  },
  "عریض": {
    "bn": "পিটিশন, প্রার্থনা, অনুরোধ, যাচনপত্র, দরখাস্ত",
    "ro": "Ariz"
  },
  "عریضہ": {
    "bn": "ভাববাদী, ভবিষ্যদ্বক্তা, পিটিশন, প্রার্থনা, অনুরোধ",
    "ro": "Ariza"
  },
  "عزا": {
    "bn": "বিলাপ, শোক, শোকসূচক বস্তু, শোকজনক, শ্রদ্ধাঞ্জলি",
    "ro": "Aza"
  },
  "عزادار": {
    "bn": "শোক, দুঃখ, মাতম",
    "ro": "Azadar"
  },
  "عزاداری": {
    "bn": "উৎসর্গ করা, একান্তভাবে নিয়োজিত করা, বিলাপ, শোক, শোকসূচক বস্তু",
    "ro": "Azadari"
  },
  "عزائم": {
    "bn": "লক্ষ্য, নিরূপণ, উদ্দেশ্য, অভীষ্ট লক্ষ্য, অভিপ্রায়",
    "ro": "Azaim"
  },
  "عزت": {
    "bn": "সম্মান, মর্যাদা, সম্ভ্রম, গৌরব",
    "ro": "'izzat"
  },
  "عزسمہ": {
    "bn": "ঘেরাত্ত, ঘিরা, আটক, আটকা, বাঁধা",
    "ro": "Azsma"
  },
  "عزلت": {
    "bn": "বিচ্ছিন্নতা, বিচ্ছেদ, বিভাজন, ফাটল",
    "ro": "Azlt"
  },
  "عزم": {
    "bn": "নির্ধারণ, স্থিরীকরণ, স্থির সংকল্প, নিরূপণ, অভীষ্ট লক্ষ্য",
    "ro": "Azm"
  },
  "عزمت": {
    "bn": "সংকল্প, উদ্দেশ্য, ইচ্ছা, অভিপ্রায়",
    "ro": "Azmt"
  },
  "عزوجل": {
    "bn": "ঘেরাত্ত, ঘিরা, আটক, আটকা, সর্বশক্তিমান",
    "ro": "Azojl"
  },
  "عزیز": {
    "bn": "প্রিয়, প্রিয়জন, সম্মানিত",
    "ro": "Aziz"
  },
  "عزیزان": {
    "bn": "প্রিয়, অত্যন্ত প্রিয়, দয়িত, মনপসন্দ",
    "ro": "Azizan"
  },
  "عزیزداری": {
    "bn": "প্রিয়তা, মহার্ঘতা, মূল্যবৃদ্ধি, মুদ্রাস্ফীতি",
    "ro": "Azizdari"
  },
  "عزیزہ": {
    "bn": "প্রিয়, দুর্মূল্য, মনপসন্দ, মনের মতো",
    "ro": "عزیزہ"
  },
  "عزیمت": {
    "bn": "দুর্বল, শক্তিহীন, কমজোর, স্বাস্থ্যহীন, নরম",
    "ro": "Azimat"
  },
  "عسالہ": {
    "bn": "প্রসন্নতা, প্রসাদগুণ, মাধুর্য, লাবণ্য, আকর্ষণ",
    "ro": "Asala"
  },
  "عسرت": {
    "bn": "অসুবিধা, কষ্ট, ক্লেশ, তাকলিফ",
    "ro": "Usrat"
  },
  "عسس": {
    "bn": "সারমর্ম, মনন, প্রাণবন্ত ব্যক্তি",
    "ro": "Asas"
  },
  "عسکر": {
    "bn": "সৈন্য, সেনাবাহিনী, সিপাহি, সেনাদল",
    "ro": "Askar"
  },
  "عسکریت": {
    "bn": "জঙ্গিবাদ, সন্ত্রাসবাদ, সন্ত্রাস, নৈরাজ্য সৃষ্টি",
    "ro": "Askarit"
  },
  "عسل": {
    "bn": "নিরপরাধ, নিরীহ, নিষ্পাপ, সরল, ভাল",
    "ro": "'asal"
  },
  "عشاق": {
    "bn": "প্রেমিক, প্রেমাসক্ত, অনুরাগী",
    "ro": "Ushshaq"
  },
  "عشائر": {
    "bn": "উপজাতি, গোত্র, সম্প্রদায়, বংশ",
    "ro": "Ashair"
  },
  "عشائیہ": {
    "bn": "নৈশভোজ, রাতের খাবার, সান্ধ্য ভোজসভা, ডিনার পার্টি",
    "ro": "'ishaaiya"
  },
  "عشبہ": {
    "bn": "ভেষজ, ওষুধ, দাওয়াই, কাঠ",
    "ro": "Ushbah"
  },
  "عشر": {
    "bn": "মেয়েলি, দুর্বল, বলহীন বা হীনবীর্য করা, খাসি বা খোজা করা, পুরুষত্বহীন",
    "ro": "Ushr"
  },
  "عشرات": {
    "bn": "দশক, দশ বছর, দশ দিনের সময়সীমা, দশ বছরের কাল",
    "ro": "Ashrat"
  },
  "عشرہ": {
    "bn": "দশক, দশ দিনের সময়সীমা, দশ বছরের কাল, রমজানের আশরা রহমত, মাগফিরাত বা নাজাতের দশ দিন",
    "ro": "Ashrah"
  },
  "عشری": {
    "bn": "দশমাংশ, খাজনারুপে প্রদেয় এক দশমাংশ",
    "ro": "Ushri"
  },
  "عشق": {
    "bn": "প্রেম, ভালবাসা, স্নেহ, করুণা, পেয়ার",
    "ro": "'ishq"
  },
  "عشقی": {
    "bn": "সুরা, ওষুধের, প্রেম, ভালোবাসা, প্রীতি",
    "ro": "Ashqi"
  },
  "عشقیہ": {
    "bn": "প্রেমঘটিত, প্রণয়ধর্মী, রোমান্টিক, প্রেমবিষয়ক",
    "ro": "Ishqiyaa"
  },
  "عشوہ": {
    "bn": "অন্ধকার, আঁধার, অন্ধকারময়তা, ক্ষপা, ক্ষীণালোক",
    "ro": "Ishoah"
  },
  "عشیر": {
    "bn": "ছাই, ভস্ম, মাটি, ধূলি",
    "ro": "Ashir"
  },
  "عشیق": {
    "bn": "প্রেমিকা, প্রেমিক, বঁধু",
    "ro": "عشیق"
  },
  "عصا": {
    "bn": "চিড়িতন বিশেষ তাস . সঙ্ঘ, ক্লাব, দণ্ড, লাঠি, কর্মচারিবর্গ",
    "ro": "Asa"
  },
  "عصار": {
    "bn": "বয়স, আয়ু, জীবনকাল, হায়াত",
    "ro": "Asar"
  },
  "عصب": {
    "bn": "বন্ধনী, পেশী, মাংসপেশী, দেহের মাংস, দৈহিক শক্তি",
    "ro": "Asab"
  },
  "عصبابی": {
    "bn": "স্নায়বিকতা, স্নায়বিক দুর্বলাবস্থা, ভয়",
    "ro": "Asababi"
  },
  "عصبات": {
    "bn": "স্নায়ু, স্নায়বিক অবস্থা, স্নায়বিক অবস্থা, রগ",
    "ro": "Asbat"
  },
  "عصبانی": {
    "bn": "রাগান্বিত, ক্রুদ্ধ, বিষাদময়, ক্ষুব্ধ",
    "ro": "Asbani"
  },
  "عصبی": {
    "bn": "স্নায়বিক, স্নায়ুচাপে পীড়িত, সহজে বিচলিত, সহজবিক্ষুব্ধ, আশুউত্তেজিত",
    "ro": "Asabi"
  },
  "عصبیت": {
    "bn": "দেখা, অবেক্ষণ করা, দৃষি্টপাত করা, তাকান, পর্যবেক্ষণ করা",
    "ro": "Asabyat"
  },
  "عصری": {
    "bn": "সমসাময়িক, যুগপৎ, বর্তমান সময়ের",
    "ro": "Asri"
  },
  "عصمت": {
    "bn": "অসম্পূর্ণতা, ত্রুটি, দোষ, খুঁত",
    "ro": "Ismat"
  },
  "عصیان": {
    "bn": "অবাধ্যতা, বিদ্রোহ, নাফরমানি, পাপাচরণ, বিরুদ্ধাচারণ",
    "ro": "'isyaan"
  },
  "عصیاں": {
    "bn": "বিদ্রোহ, রাজবিদ্রোহ, অবাধ্যতা, নাফরমানি",
    "ro": "Asyan"
  },
  "عصیدہ": {
    "bn": "পোরিজ, পুডিং বিশেষ, পরিজ, জাউ",
    "ro": "Asidah"
  },
  "عصیہ": {
    "bn": "এশিয়া, বিশ্বের বৃহত্তম ও সর্বাধিক জনবহুল মহাদেশ, এশিয়া মহাদেশ, প্রাচ্য ভূখণ্ড",
    "ro": "Usaih"
  },
  "عضلات": {
    "bn": "খারাপ, মন্দ, অন্যায়, অসত্‍, বাজে",
    "ro": "Azlat"
  },
  "عضلہ": {
    "bn": "পেশি, মাংসপেশি, শারীরিক পেশিতন্তু, সংকোচনশীল মাংসপেশি, শক্তিমান পেশি",
    "ro": "Azlah"
  },
  "عضو": {
    "bn": "সদস্য, আইনসভার প্রতিনিধি, অঙ্গ প্রতঙ্গ, প্রদান, নিবসন",
    "ro": "Uzv"
  },
  "عضوض": {
    "bn": "অঙ্গ, শরীর, দেহ, উপাদান",
    "ro": "Azoz"
  },
  "عضوی": {
    "bn": "জীব, প্রাণী, পশু, জানোয়ার",
    "ro": "Uzoi"
  },
  "عضویاتی": {
